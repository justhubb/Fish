-- รอบขาย: หยุดตก -> ขาย (ไรเดอร์ / ร้านค้า) -> กลับจุดฟาม -> ตกต่อ
local function cycle()
    local r = root(); if not r then return false end
    if passDisabled and os.clock() - passDisabledAt > 600 then passDisabled, passFails = false, 0 end   -- ลองเกมพาสใหม่ทุก 10 นาที
    local back = home or r.CFrame
    pauseFish()
    unequipRod()
    local sold = false

    if S.sellMode == "pass" and not passDisabled then
        for i = 1, 2 do
            if not alive then return false end
            if sellInPlace() then sold = true break end
            if passDisabled then break end
            if i < 2 then setStatus("ขายด้วยไรเดอร์ไม่สำเร็จ — ลองใหม่ (" .. i .. "/2)"); task.wait(2) end
        end
        if sold then
            passFails = 0
        else
            passFails += 1
            if passFails >= 2 then disablePass() end
            setStatus("ไรเดอร์ไม่ได้ผล — ไปขายที่ร้านแทนรอบนี้")
            task.wait(1)
        end
    end

    if not sold then
        -- รอจนขายเสร็จจริง (ลองซ้ำสูงสุด 3 ครั้ง) แล้วค่อยกลับจุดฟาม
        for i = 1, 3 do
            if not alive then return false end
            if sellStep() then sold = true break end
            if i < 3 then setStatus("ขายไม่สำเร็จ — ลองใหม่ (" .. i .. "/3)"); task.wait(1.5) end
        end
        task.wait(0.5)
        setStatus("กลับจุดฟาม...")
        travel(back, true)
    end

    if not sold then lastSellFail = os.clock() end
    if farmOn then resumeFish(); setStatus(sold and "ฟามต่อ" or "ขายไม่สำเร็จ — ฟามต่อแล้วลองขายใหม่ภายหลัง") end
    return sold
end

local function farmTick()
    local r = root(); if not r then return end
    local h = hum(); if h and h.Health <= 0 then return end
    if home and (r.Position - home.Position).Magnitude > 10 then
        pauseFish()
        setStatus("ไปจุดฟาม...")
        travel(home, true)
        resumeFish()
        return
    end
    if not running then resumeFish() end
    -- ลูปตกปลาเงียบเกินไป (ไม่มีสถานะ/ไม่มีปลา) -> รีเซ็ตให้ใหม่
    if running and os.clock() - lastActivity > CFG.STALL_RESET then
        setStatus("เงียบนาน — รีเซ็ตลูปตกปลา")
        pauseFish()
        if home then travel(home, true) end
        resumeFish()
        return
    end
    if S.autoSell and os.clock() - lastSellFail > 20 and shouldSell() then
        local c, m = bagState()
        setStatus("กระเป๋า " .. c .. "/" .. m .. " ถึงเกณฑ์ขาย (" .. sellThreshold() .. ") — เริ่มขาย")
        cycle()
    end
end

task.spawn(function()
    while alive do
        task.wait(0.4)
        if farmOn and not busy then
            busy = true
            local ok, err = pcall(farmTick)
            if not ok then setStatus("ผิดพลาด: " .. tostring(err)) end
            busy = false
        end
    end
end)

local function manual()
    if busy then setStatus("กำลังทำงานอยู่ รอสักครู่") return end
    busy = true
    local ok, err = pcall(cycle)
    if not ok then setStatus("ผิดพลาด: " .. tostring(err)) end
    busy = false
end

