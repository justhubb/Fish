        TextColor3 = C.red, TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd}, head)
    mk("TextLabel", {Size = UDim2.fromOffset(18, 36), Position = UDim2.new(1, -20, 0, 0), BackgroundTransparency = 1, Text = "▾",
        TextColor3 = C.sub, TextSize = 12, Font = Enum.Font.GothamBold}, head)
    local list = mk("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        Visible = false, LayoutOrder = 2}, box)
    mk("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, list)
    local obj = {}
    local opts, sel = options, selKey
    local function labelOf(k)
        for _, o in ipairs(opts) do if o.key == k then return o.label end end
        return "—"
    end
    local function rebuild()
        for _, c in ipairs(list:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        for i, o in ipairs(opts) do
            local b = mk("TextButton", {Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = C.panel2, BorderSizePixel = 0, Text = "   " .. o.label,
                TextColor3 = (o.key == sel) and C.red or C.text, TextSize = 12, Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = i}, list)
            b.MouseButton1Click:Connect(function()
                sel = o.key; val.Text = o.label; list.Visible = false; rebuild(); cb(o.key)
            end)
        end
        val.Text = labelOf(sel)
    end
    function obj.setOptions(o, s) opts = o; sel = s; rebuild() end
    head.MouseButton1Click:Connect(function() list.Visible = not list.Visible end)
    rebuild()
    return obj
end

