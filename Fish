local farmOn, busy = false, false
local home, startAt = nil, 0

local function spotCF()
    for _, sp in ipairs(spots) do
        if sp.name == S.spotName and type(sp.c) == "table" and #sp.c == 12 then
            return CFrame.new(table.unpack(sp.c))
        end
    end
end

local function cycle()
    local r = root(); if not r then return end
    if S.sellMode == "pass" and not passDisabled then
        if sellInPlace() then return end
        passDisabled = true
        setStatus("ขายจากกระเป๋าไม่ได้ (ไม่มีเกมพาส?) — ไปขายที่ร้านแทน")
        task.wait(1)
    end
    local back = home or r.CFrame
    pauseFish()
    -- รอจนขายเสร็จจริง (ลองซ้ำสูงสุด 3 ครั้ง) แล้วค่อยวาปกลับจุดฟาม
    for i = 1, 3 do
        if sellStep() then break end
        if i < 3 then setStatus("ขายไม่สำเร็จ — ลองใหม่ (" .. i .. "/3)"); task.wait(1.5) end
    end
    task.wait(0.5)
    setStatus("กลับจุดฟาม...")
    travel(back, true)
    if farmOn then resumeFish(); setStatus("ฟามต่อ") end
end

local function farmTick()
    local r = root(); if not r then return end
    if home and (r.Position - home.Position).Magnitude > 10 then
        pauseFish()
        setStatus("ไปจุดฟาม...")
        travel(home, true)
        resumeFish()
        return
    end
    if not running then resumeFish() end
    if S.autoSell and os.clock() - lastSellFail > 30 and bagNearFull() then
        cycle()
    end
end

task.spawn(function()
    while alive do
        task.wait(0.4)
        if farmOn and not busy then
            busy = true
            local ok, err = pcall(farmTick)
            if not ok then setStatus("ผิดพลาด: " .. tostring(err)) end
            busy = false
        end
    end
end)

local function manual()
    if busy then setStatus("กำลังทำงานอยู่ รอสักครู่") return end
    busy = true
    local ok, err = pcall(cycle)
    if not ok then setStatus("ผิดพลาด: " .. tostring(err)) end
    busy = false
end

