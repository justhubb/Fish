    SELL_SPOTS   = { Vector3.new(418.12, 12.98, 524.40), Vector3.new(255.04, 12.74, -19.41) },
    WALK_SPEED   = 40,     -- ความเร็วโหมดเดินไว
    WALK_TIMEOUT = 25,     -- เดินนานเกินนี้ (วิ) -> วาปแทน
    WARP_WAIT    = 0.35,   -- รอหลังถึงจุดก่อนขาย/ตี
    SELL_MARGIN  = 1,      -- ขายเมื่อที่ว่างเหลือ <= ค่านี้
