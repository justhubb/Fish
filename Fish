local function fakeInput(state, x, y)
    return {
        UserInputType = Enum.UserInputType.Touch, UserInputState = state,
        KeyCode = Enum.KeyCode.Unknown, Position = Vector3.new(x, y, 0), Delta = Vector3.zero,
        IsA = function() return true end,
    }
end

local function callConns(sig, ...)
    local n = 0
    if type(getconnections) ~= "function" then return 0 end
    local args = table.pack(...)
    pcall(function()
        for _, c in ipairs(getconnections(sig)) do
            local f = c.Function
            if f then
                n += 1; task.spawn(pcall, f, table.unpack(args, 1, args.n))
            elseif c.Fire then
                n += 1; task.spawn(pcall, c.Fire, c, table.unpack(args, 1, args.n))
            end
        end
    end)
    return n
end

local function screenPoint(btn, gui)
    local p, s = btn.AbsolutePosition, btn.AbsoluteSize
    local x, y = p.X + s.X / 2, p.Y + s.Y / 2
    if gui and gui:IsA("ScreenGui") and not gui.IgnoreGuiInset then y = y + GuiService:GetGuiInset().Y end
    return x, y
end

-- กันคลิกพลาดไปโดนปุ่ม Roblox (แถบบนซ้าย): คืนพิกัดเฉพาะเมื่อปุ่มมองเห็นจริงและอยู่นอกแถบบน
local function safePoint(b)
    if not (b and b.Parent and b.Visible and b.AbsoluteSize.X > 4 and b.AbsoluteSize.Y > 4) then return end
    local x, y = screenPoint(b, b:FindFirstAncestorOfClass("ScreenGui"))
    local cam2 = workspace.CurrentCamera
    local v = cam2 and cam2.ViewportSize
    if y < 70 or x < 4 or (v and (x > v.X or y > v.Y)) then return end
    return x, y
end

local function clickGui(b)
    if not (b and b.Parent) then return end
    local n = 0
    if type(getconnections) == "function" then
        n = callConns(b.MouseButton1Click)
        if n == 0 then n = callConns(b.Activated, fakeInput(Enum.UserInputState.Begin, 0, 0), 1) end
    end
    if n == 0 and VIM then
        local x, y = safePoint(b)
        if not x then return end
        pcall(function()
            VIM:SendMouseButtonEvent(x, y, 0, true, game, 0); task.wait(0.05)
            VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
    end
end

