-- ขายด้วยเกมพาส (ไรเดอร์) — ยิง event/รีโมตตรง ๆ ไม่ต้องแตะปุ่ม ไม่สุ่มกด
-- ลำดับเหมือนที่เกมทำจริง: Call -> (ไรเดอร์มา) OpenShop("rider") -> sellAll -> FoxRider "done"
local function riderSell()
    local before = bagCountRemote()
    if before == nil then before = (bagState()) end
    if before == 0 then setStatus("กระเป๋าว่าง ไม่ต้องขาย") return true end
    local coins0 = readCoins()
    local callEvt, openEvt = riderEvents()
    local usedGui = false

    -- 1) รอคูลดาวน์ไรเดอร์
    local tc = os.clock()
    while alive and os.clock() - tc < 70 do
        local cd = riderCooldownLeft()
        if cd <= 0 then break end
        setStatus("รอคูลดาวน์ไรเดอร์ " .. math.ceil(cd) .. " วิ...")
        task.wait(math.min(cd, 1))
    end

    -- 2) เรียกไรเดอร์: ยิง FoxRiderClient.Call (ถ้าไม่เจอ event ค่อยกดปุ่มในกระเป๋า 1 ครั้ง)
    local t0 = os.clock()
    lastRiderCall = t0
    setStatus("เรียกไรเดอร์...")
    local function callRider()
        if callEvt then
            callEvt:Fire()
        else
            usedGui = true
            if not fishTabReady() then openBagFish() end
            local b = bagSellButton()
            if not b then return false end
            clickGui(b)
        end
        return true
    end
    if not callRider() then
        setStatus("ไม่พบ event/ปุ่มเรียกไรเดอร์")
        return false
    end
    task.wait(0.8)
    if shopDetailAt >= t0 then   -- เด้งหน้าซื้อเกมพาส = ไม่มีเกมพาส
        closePurchasePopup()
        disablePass()
        setStatus("ไม่มีเกมพาส (เด้งหน้าซื้อ) — ปิดแล้ว ไปขายที่ร้านแทน")
        return false
    end

    -- 3) รอไรเดอร์มาถึง = เกมตั้ง FoxRiderShop / FoxFishShopMode="rider"
    --    ไม่ได้ผลใน 8 วิ -> ยิง OpenShop("rider") เองครั้งเดียว (เหมือนที่เกมยิง)
    local arrived, forced = false, false
    local tw = os.clock()
    while alive and os.clock() - tw < CFG.RIDER_ARRIVE do
        if riderShopOpen() then arrived = true break end
        if shopDetailAt >= t0 then
            closePurchasePopup(); disablePass()
            setStatus("ไม่มีเกมพาส (เด้งหน้าซื้อ) — ไปขายที่ร้านแทน")
            return false
        end
        if not forced and os.clock() - tw > 8 and openEvt then
            forced = true
            setStatus("ไรเดอร์มาช้า — สั่งเปิดหน้าร้านไรเดอร์")
            openEvt:Fire("rider")
        else
            setStatus("รอไรเดอร์มาถึง " .. math.max(0, math.ceil(CFG.RIDER_ARRIVE - (os.clock() - tw))) .. " วิ...")
        end
        task.wait(0.25)
    end
    if not arrived then
        setStatus("ไรเดอร์ไม่มา (คูลดาวน์/จุดนี้เรียกไม่ได้?)")
        if bagIsOpen() then closeBag() end
        return false
    end

    -- 4) ขาย: สั่ง sellAll ตรง ๆ (เหมือนที่ปุ่มขายยิง) แล้วรอจำนวนปลานิ่ง
    task.wait(0.6)
    local sold, after = false, before
    for attempt = 1, 3 do
        setStatus("สั่งขาย (ไรเดอร์) " .. attempt .. "/3...")
        pcall(function() return Req:InvokeServer("sellAll") end)
        after = settleBag(before)
        if after and after < before then sold = true break end
        if attempt == 2 then   -- สำรอง: กดปุ่มขายในหน้าร้านไรเดอร์
            local ready, sb = sellBtnReady()
            if ready then clickGui(sb) end
        end
    end

    -- 5) ปิดร้าน: ยิง FoxRider "done" ตรง ๆ ให้ไรเดอร์ออก แล้วปิดหน้าต่างให้เรียบร้อย
    task.wait(0.4)
    if RiderRemote then pcall(function() RiderRemote:FireServer("done") end) end
    closeFishBag()
    local tl = os.clock()
    while riderShopOpen() and os.clock() - tl < 6 do task.wait(0.2) end
    if usedGui and bagIsOpen() then closeBag() end

    if sold then
        recordSale(before, after, coins0)
    else
        lastSellFail = os.clock()
        setStatus("ขายด้วยไรเดอร์ไม่สำเร็จ — จำนวนปลาไม่ลด")
    end
    return sold
end

local function sellInPlace()
    local ok, res = pcall(riderSell)
    if not ok then
        setStatus("ผิดพลาด (ไรเดอร์): " .. tostring(res))
        pcall(closeFishBag)
        pcall(function() if bagIsOpen() then closeBag() end end)
        return false
    end
    return res
end

-- ขายที่ร้าน: เลิกถือเบ็ด -> ไปจุดขาย -> เปิดร้าน -> กดขาย/ยิง sellAll แล้วรอจนจำนวนปลานิ่ง -> สรุปผล -> ปิดร้าน
local function sellStep()
    local r = root(); if not r then return false end
    unequipRod()
    local spot = nearestSell(r.Position)
    local idx = 1
    for i, v in ipairs(CFG.SELL_SPOTS) do if v == spot then idx = i end end
    setStatus("ไปจุดขายที่ใกล้สุด (จุด " .. idx .. "/" .. #CFG.SELL_SPOTS .. ", ห่าง " .. math.floor((spot - r.Position).Magnitude) .. " หน่วย)...")
    travel(CFrame.new(spot), false)
    task.wait(CFG.WARP_WAIT)
    unequipRod()
    local before = bagCountRemote()
    if before == 0 then setStatus("กระเป๋าว่าง ไม่ต้องขาย") return true end
    local coins0 = readCoins()

    -- 1) กดเปิดร้านค้า (ลองสูงสุด 3 รอบ) — นับว่าเปิดแล้วเมื่อเซิร์ฟเวอร์ส่ง "shop" หรือหน้าร้านขึ้น
    local opened = false
    for i = 1, 3 do
        setStatus("กดเปิดร้านค้า... (" .. i .. "/3)")
        local t0 = os.clock()
        opened = usePrompt(spot, 3, function() return shopEventAt >= t0 or shopOpen() end)
        if opened then break end
        task.wait(0.5)
    end

    -- 2) กดปุ่มขายในร้าน (2 รอบแรก) แล้วสำรองด้วยรีโมต sellAll — "รอจนขายเสร็จ" (จำนวนปลานิ่ง)
    if opened then task.wait(0.5) end
    local ok, after = false, before
    for attempt = 1, 4 do
        local ready, sb = sellBtnReady()
        if attempt <= 2 and ready then
            setStatus("กดปุ่มขายในร้าน " .. attempt .. "/4...")
            if attempt == 2 then
                if not clickReal(sb) then clickGui(sb) end
            else
                clickGui(sb)
            end
        else
            setStatus("สั่งขาย (รีโมต) " .. attempt .. "/4...")
            pcall(function() return Req:InvokeServer("sellAll") end)
        end
        local last, same, t1 = nil, 0, os.clock()
        while os.clock() - t1 < 6 do
            task.wait(0.5)
            local n = bagCountRemote()
            if n == nil then break end
            after = n
            if n == 0 then break end
            if n == last then same += 1 else same = 0 end
            last = n
            if same >= 2 then break end
        end
        if before == nil or after == nil or after < before then ok = true break end
    end

    -- 3) สรุปผล
    if ok then
        recordSale(before, after, coins0)
    else
        lastSellFail = os.clock()
        setStatus(opened and "ขายไม่สำเร็จ — เปิดร้านแล้วแต่จำนวนปลาไม่ลด"
            or "เปิดร้านไม่ได้ — ปุ่มโต้ตอบไม่ขึ้น/กดไม่ติด (ยืนใกล้ร้านไหม)")
    end

    -- 4) ปิดหน้าร้าน (หลังขายเสร็จเท่านั้น)
    if shopOpen() or sellBtnReady() then closeFishBag() end
    return ok
end

