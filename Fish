local function setFarm(v)
    if v == farmOn then return end
    if v then
        local r = root(); if not r then setStatus("ไม่พบตัวละคร") return end
        local cf = spotCF()
        home = cf or r.CFrame
        startAt = os.clock()
        farmOn = true
        setStatus(cf and "เริ่มฟาม — ไปจุดฟาม" or "เริ่มฟาม (ตกตรงที่ยืน)")
    else
        farmOn = false
        home = nil
        paintStart()
        pauseFish()
        setStatus("หยุดฟามแล้ว")
    end
    paintStart()
end
