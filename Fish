local function nearestPrompt(pos, maxDist)
    local best, bd
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local p = d.Parent
            local part = p and (p:IsA("BasePart") and p or (p:IsA("Attachment") and p.Parent)
                or p:FindFirstChildWhichIsA("BasePart", true))
            if part and part:IsA("BasePart") then
                local dist = (part.Position - pos).Magnitude
                if dist < maxDist and (not bd or dist < bd) then best, bd = d, dist end
            end
        end
    end
    return best
end

-- กดปุ่มโต้ตอบ (FoxPrompt) ให้ "เปิดร้านจริง" — ลองทีละวิธีแล้วเช็กด้วย verify() ว่าเปิดแล้วหรือยัง
local function usePrompt(pos, timeout, verify)
    if verify() then return true end
    local t0, btn = os.clock(), nil
    while os.clock() - t0 < timeout do
        btn = promptButton()
        if btn then break end
        task.wait(0.1)
    end
    local tries = {}
    tries[1] = function()   -- ลอง ProximityPrompt ก่อน (ไม่ต้องคลิกจอ)
        local p = nearestPrompt(pos, 25)
        if p and type(fireproximityprompt) == "function" then
            p.HoldDuration = 0
            fireproximityprompt(p)
        end
    end
    if btn then
        local x, y = screenPoint(btn, btn:FindFirstAncestorOfClass("ScreenGui"))
        tries[#tries + 1] = function() clickGui(btn) end
        tries[#tries + 1] = function()   -- ปุ่มโต้ตอบแบบกด: InputBegan -> InputEnded
            callConns(btn.InputBegan, fakeInput(Enum.UserInputState.Begin, x, y), false)
            task.wait(0.15)
            callConns(btn.InputEnded, fakeInput(Enum.UserInputState.End, x, y), false)
        end
        if VIM and safePoint(btn) then
            tries[#tries + 1] = function()
                VIM:SendMouseButtonEvent(x, y, 0, true, game, 0); task.wait(0.12)
                VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
            end
            tries[#tries + 1] = function()
                VIM:SendTouchEvent(88, 0, x, y); task.wait(0.12)
                VIM:SendTouchEvent(88, 2, x, y)
            end
        end
    end
    for _, fn in ipairs(tries) do
        pcall(fn)
        local t1 = os.clock()
        while os.clock() - t1 < 1.0 do
            task.wait(0.1)
            if verify() then return true end
        end
    end
    return verify()
end

