local function recordSale(before, after, coins0)
    local soldN = (before and after) and (before - after) or 0
    local gained = 0
    if soldN > 0 and coins0 then
        local c1, t2 = readCoins(), os.clock()
        while c1 and c1 <= coins0 and os.clock() - t2 < 2 do task.wait(0.2); c1 = readCoins() end
        if c1 then gained = math.max(0, c1 - coins0) end
    end
    stats.sold += 1; stats.soldFish += soldN; stats.coinsEarned += gained
    stats.lastFish, stats.lastCoins = soldN, gained
    fishSinceSell = 0; lastSellFail = 0
    local c, m = bagLabel()
    setStatus("ขายแล้ว " .. soldN .. " ตัว +" .. gained .. " เหรียญ ✓" .. (c and (" | กระเป๋า " .. c .. "/" .. tostring(m)) or ""))
end

