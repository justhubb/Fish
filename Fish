local function settleBag(before)
    local after, last, same, t1 = before, nil, 0, os.clock()
    while os.clock() - t1 < 5 do
        task.wait(0.5)
        local n = bagCountRemote()
        if n == nil then break end
        after = n
        if n == 0 then break end
        if n == last then same += 1 else same = 0 end
        last = n
        if same >= 2 then break end
    end
    return after
end

local function sellInPlace()
    local before = bagCountRemote()
    if before == 0 then setStatus("กระเป๋าว่าง ไม่ต้องขาย") return true end
    if before == nil then return false end
    local coins0 = readCoins()
    for attempt = 1, 2 do
        if attempt == 1 then
            -- วิธีเดียวกับที่กดเอง: กด 1 รอบ (เรียกไรเดอร์) รอ 3-4 วิ แล้วกดที่เดิมอีก 1 รอบ (ขาย)
            local btn = bagSellButton()
            if btn then
                local cd = 30 - (os.clock() - lastRiderCall)   -- เรียกไรเดอร์ได้ทุก 30 วิ
                if cd > 0 then
                    setStatus("รอคูลดาวน์ไรเดอร์ " .. math.ceil(cd) .. " วิ...")
                    task.wait(cd)
                end
                local t0 = os.clock()
                lastRiderCall = t0
                setStatus("ขายจากกระเป๋า: กดรอบที่ 1 (เรียกไรเดอร์)...")
                clickGui(btn)
                task.wait(0.8)
                if shopDetailAt >= t0 then   -- เด้งหน้าซื้อเกมพาส = ไม่มีเกมพาส
                    closePurchasePopup()
                    passDisabled = true
                    setStatus("ไม่มีเกมพาส (เด้งหน้าซื้อ) — ปิดแล้ว ไปขายที่ร้านแทน")
                    return false
                end
                local w = 2.2 + math.random()
                setStatus("รอไรเดอร์มา " .. string.format("%.1f", w + 0.8) .. " วิ แล้วกดรอบที่ 2...")
                task.wait(w)
                btn = bagSellButton() or btn
                clickGui(btn)
                task.wait(0.5)
                if shopDetailAt >= t0 then closePurchasePopup() end
            end
        else
            setStatus("ขายจากกระเป๋า (รีโมต)...")
            pcall(function() return Req:InvokeServer("sellAll") end)
        end
        local after = settleBag(before)
        if after and after < before then
            recordSale(before, after, coins0)
            return true
        end
    end
    return false
end

local function unequipRod()
    local h = hum()
    if h then pcall(function() h:UnequipTools() end) end
end

-- ขาย: เลิกถือเบ็ด -> ไปจุดขาย -> เปิดร้าน -> ยิง sellAll แล้วรอจนจำนวนปลานิ่ง -> สรุปผล -> ปิดร้าน
local function sellStep()
    local r = root(); if not r then return false end
    unequipRod()
    local spot = nearestSell(r.Position)
    local idx = 1
    for i, v in ipairs(CFG.SELL_SPOTS) do if v == spot then idx = i end end
    setStatus("ไปจุดขายที่ใกล้สุด (จุด " .. idx .. "/" .. #CFG.SELL_SPOTS .. ", ห่าง " .. math.floor((spot - r.Position).Magnitude) .. " หน่วย)...")
    travel(CFrame.new(spot), false)
    task.wait(CFG.WARP_WAIT)
    unequipRod()
    local before = bagCountRemote()
    if before == 0 then setStatus("กระเป๋าว่าง ไม่ต้องขาย") return true end
    local coins0 = readCoins()

    -- 1) กดเปิดร้านค้า (ลองสูงสุด 3 รอบ) — นับว่าเปิดแล้วเมื่อเซิร์ฟเวอร์ส่ง "shop" หรือหน้าร้านขึ้น
    local opened = false
    for i = 1, 3 do
        setStatus("กดเปิดร้านค้า... (" .. i .. "/3)")
        local t0 = os.clock()
        opened = usePrompt(spot, 3, function() return shopEventAt >= t0 or shopOpen() end)
        if opened then break end
        task.wait(0.5)
    end

    -- 2) ขายด้วยรีโมต sellAll แล้ว "รอจนขายเสร็จ" (จำนวนปลานิ่ง) ลองสูงสุด 4 รอบ
    if opened then task.wait(0.5) end
    local ok, after = false, before
    for attempt = 1, 4 do
        setStatus("สั่งขาย (รีโมต) " .. attempt .. "/4...")
        pcall(function() return Req:InvokeServer("sellAll") end)
        local last, same, t1 = nil, 0, os.clock()
        while os.clock() - t1 < 6 do
            task.wait(0.5)
            local n = bagCountRemote()
            if n == nil then break end
            after = n
            if n == 0 then break end
            if n == last then same += 1 else same = 0 end
            last = n
            if same >= 2 then break end
        end
        if before == nil or after == nil or after < before then ok = true break end
    end

    -- 3) สรุปผล
    if ok then
        recordSale(before, after, coins0)
    else
        lastSellFail = os.clock()
        setStatus(opened and "ขายไม่สำเร็จ — เปิดร้านแล้วแต่จำนวนปลาไม่ลด"
            or "เปิดร้านไม่ได้ — ปุ่มโต้ตอบไม่ขึ้น/กดไม่ติด (ยืนใกล้ร้านไหม)")
    end

    -- 4) ปิดหน้าร้าน (หลังขายเสร็จเท่านั้น)
    if shopOpen() or sellBtnReady() then
        local _, _, closeBtn = fishBagParts()
        if closeBtn then clickGui(closeBtn); task.wait(0.3) end
    end
    return ok
end

