local function rnd(r) return r[1] + math.random() * (r[2] - r[1]) end
local function root() local c = lp.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function hum() local c = lp.Character; return c and c:FindFirstChildOfClass("Humanoid") end

local VIM = nil
pcall(function() VIM = game:GetService("VirtualInputManager") end)

local function fakeInput(state, x, y)
    return {
        UserInputType = Enum.UserInputType.Touch, UserInputState = state,
        KeyCode = Enum.KeyCode.Unknown, Position = Vector3.new(x, y, 0), Delta = Vector3.zero,
        IsA = function() return true end,
    }
end

local function callConns(sig, ...)
    local n = 0
    if type(getconnections) ~= "function" then return 0 end
    local args = table.pack(...)
    pcall(function()
        for _, c in ipairs(getconnections(sig)) do
            local f = c.Function
            if f then
                n += 1; task.spawn(pcall, f, table.unpack(args, 1, args.n))
            elseif c.Fire then
                n += 1; task.spawn(pcall, c.Fire, c, table.unpack(args, 1, args.n))
            end
        end
    end)
    return n
end

local function screenPoint(btn, gui)
    local p, s = btn.AbsolutePosition, btn.AbsoluteSize
    local x, y = p.X + s.X / 2, p.Y + s.Y / 2
    if gui and gui:IsA("ScreenGui") and not gui.IgnoreGuiInset then y = y + GuiService:GetGuiInset().Y end
    return x, y
end

-- กันคลิกพลาดไปโดนปุ่ม Roblox (แถบบนซ้าย): คืนพิกัดเฉพาะเมื่อปุ่มมองเห็นจริงและอยู่นอกแถบบน
local function safePoint(b)
    if not (b and b.Parent and b.Visible and b.AbsoluteSize.X > 4 and b.AbsoluteSize.Y > 4) then return end
    local x, y = screenPoint(b, b:FindFirstAncestorOfClass("ScreenGui"))
    local cam2 = workspace.CurrentCamera
    local v = cam2 and cam2.ViewportSize
    if y < 70 or x < 4 or (v and (x > v.X or y > v.Y)) then return end
    return x, y
end

local function clickGui(b)
    local n = 0
    if type(getconnections) == "function" then
        n = callConns(b.MouseButton1Click)
        if n == 0 then n = callConns(b.Activated, fakeInput(Enum.UserInputState.Begin, 0, 0), 1) end
    end
    if n == 0 and VIM then
        local x, y = safePoint(b)
        if not x then return end
        pcall(function()
            VIM:SendMouseButtonEvent(x, y, 0, true, game, 0); task.wait(0.05)
            VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
    end
end

-- ==================== สถานะตกปลา ====================
local running = false
local st, stSince, lastDone, token = "idle", os.clock(), 0, 0
local caught, fishSinceSell = 0, 0
local stats = {sold = 0, soldFish = 0, coinsEarned = 0, lastFish = 0, lastCoins = 0}
local rodIdx, autoRod = 1, true
local waterOf = {FoxRodSea = "sea"}
local castPending, castAt = false, 0
local failCount, streak = 0, 0
local holding = false
local function curRod() return ROD_ORDER[rodIdx] end

local function applyRodSetting()
    if S.fishRod == "auto" then
        autoRod = true
        local c = lp.Character
        for i, r in ipairs(ROD_ORDER) do if c and c:FindFirstChild(r) then rodIdx = i end end
    else
        autoRod = false
        local want = (S.fishRod == "sea") and "FoxRodSea" or "FoxRodFresh"
        for i, r in ipairs(ROD_ORDER) do if r == want then rodIdx = i end end
    end
    failCount, streak = 0, 0
end
applyRodSetting()

local function ensureRod()
    local ROD = curRod()
    local c = lp.Character; if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid"); if not h or h.Health <= 0 then return false end
    if c:FindFirstChild(ROD) then return true end
    local bp = lp:FindFirstChild("Backpack")
    local tool = bp and bp:FindFirstChild(ROD)
    if not tool then
        local bag = lp:FindFirstChild("FoxBag")
        local inBag = bag and bag:FindFirstChild(ROD)
        if inBag and BagAction then
            BagAction:FireServer("take", inBag)
            local t0 = os.clock()
            while os.clock() - t0 < 3 and not tool do task.wait(0.1); tool = bp and bp:FindFirstChild(ROD) end
        end
    end
    if tool then
        pcall(function() h:EquipTool(tool) end)
        task.wait(0.4)
        return c:FindFirstChild(ROD) ~= nil
    end
    return false
end

local function switchRod(why)
    if not autoRod then return end
    rodIdx = rodIdx % #ROD_ORDER + 1
    failCount = 0
    setStatus("สลับเป็นเบ็ด" .. (ROD_NAME[curRod()] or curRod()) .. " (" .. why .. ")")
end

local function onFail(why, skipCancel)
    failCount += 1; streak += 1
    if not skipCancel then Remote:FireServer("cancel") end
    st, stSince = "idle", os.clock()
    lastDone = os.clock() + 1.5
    if failCount >= CFG.FAIL_LIMIT and autoRod then switchRod(why) else setStatus(why) end
    local cycleLen = CFG.FAIL_LIMIT * (autoRod and #ROD_ORDER or 1)
    if streak % cycleLen == 0 then
        lastDone = os.clock() + CFG.PAUSE_BOTH
        setStatus("ตกไม่ได้ตรงนี้ — พัก " .. CFG.PAUSE_BOTH .. " วิ (เช็กว่ายืนที่น้ำและเบ็ดถูกชนิด)")
    end
end

local function onWater(w)
    if not w then return end
    if not autoRod then streak, failCount = 0, 0 return end
    local cur = curRod()
    local other = ROD_ORDER[rodIdx % #ROD_ORDER + 1]
    local mine = waterOf[cur]
    if mine == nil and waterOf[other] ~= w then waterOf[cur] = w; mine = w end
    if mine == w then streak, failCount = 0, 0 return end
    if waterOf[other] == nil then waterOf[other] = w end
    Remote:FireServer("cancel")
    st, stSince, lastDone = "idle", os.clock(), os.clock() + 1.5
    switchRod("น้ำ " .. tostring(w) .. " ไม่ตรงกับเบ็ด")
end

-- ==================== กดปุ่ม Action ====================
local function actionButton()
    local g = lp.PlayerGui:FindFirstChild("FoxFish")
    local rc = g and g:FindFirstChild("RodControls")
    return rc and rc:FindFirstChild("Action"), g
end

local MODES = {"signal", "touch", "mouse", "uis"}
local modeIdx, locked = 1, false
local holdSince, holdZc = nil, nil
local inputLabel = MODES[modeIdx] .. "?"

local function press(mode, v, btn, gui)
    local x, y = screenPoint(btn, gui)
    local state = v and Enum.UserInputState.Begin or Enum.UserInputState.End
    if mode == "signal" then
        local n = callConns(v and btn.InputBegan or btn.InputEnded, fakeInput(state, x, y), false)
        n += callConns(v and btn.MouseButton1Down or btn.MouseButton1Up, x, y)
        return n > 0
    elseif mode == "touch" and VIM then
        return pcall(function() VIM:SendTouchEvent(77, v and 0 or 2, x, y) end)
    elseif mode == "mouse" and VIM then
        return pcall(function() VIM:SendMouseButtonEvent(x, y, 0, v, game, 0) end)
    elseif mode == "uis" then
        return callConns(v and UIS.InputBegan or UIS.InputEnded, fakeInput(state, x, y), true) > 0
    end
    return false
end

local function setHold(v)
    if v == holding then return end
    local btn, gui = actionButton()
    if not btn then return end
    press(MODES[modeIdx], v, btn, gui)
    holding = v
    holdSince = v and os.clock() or nil
    holdZc = nil
end

-- ==================== หา โซนเขียว / รูปปลา ====================
local function isGreen(c)
    local k = c.BackgroundColor3
    return k.G >= k.R and k.G >= k.B
end

local function findReel()
    local g = lp.PlayerGui:FindFirstChild("FoxFish")
    local reel = g and g:FindFirstChild("Reel")
    if not reel or not reel.Visible then return end
    local fish
    for _, d in ipairs(reel:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text:find("🐟") then fish = d; break end
    end
    if not fish then return end
    local track = fish.Parent
    local zone, fallback
    for _, c in ipairs(track:GetChildren()) do
        if c:IsA("Frame") and c.Visible and c.Name ~= "BossSky"
           and c.AbsoluteSize.Y < track.AbsoluteSize.Y * 0.95
           and c.AbsoluteSize.X <= track.AbsoluteSize.X then
            if isGreen(c) then zone = c; break end
            fallback = fallback or c
        end
    end
    zone = zone or fallback
    if zone then return fish, zone, track end
end

-- ==================== มินิเกม (คุมแถบ) ====================
local fishObj, zoneObj, trackObj
local lastZc, lastFc, lastT, svz, svf = nil, nil, nil, 0, 0
conns[#conns + 1] = RunService.RenderStepped:Connect(function()
    if not (alive and running and st == "reel") then
        if holding then setHold(false) end
        lastZc, lastFc, lastT = nil, nil, nil
        return
    end
    if not (fishObj and fishObj.Parent and zoneObj and zoneObj.Parent) then
        fishObj, zoneObj, trackObj = findReel()
        lastZc, lastFc, lastT, svz, svf = nil, nil, nil, 0, 0
        if not fishObj then return end
    end
    local now = os.clock()
    local zc = zoneObj.AbsolutePosition.Y + zoneObj.AbsoluteSize.Y / 2
    local fc = fishObj.AbsolutePosition.Y + fishObj.AbsoluteSize.Y / 2
    if lastZc and lastT and now > lastT then
        local dt = now - lastT
        svz = svz * 0.6 + ((zc - lastZc) / dt) * 0.4     -- กรองความเร็วให้นิ่ง
        svf = svf * 0.6 + ((fc - lastFc) / dt) * 0.4
    end
    lastZc, lastFc, lastT = zc, fc, now

    if holding and holdSince and not locked then
        if not holdZc then holdZc = zc end
        local atTop = trackObj and (zoneObj.AbsolutePosition.Y <= trackObj.AbsolutePosition.Y + 4)
        if holdZc - zc >= 6 then
            locked = true
            inputLabel = MODES[modeIdx] .. " ✓"
        elseif now - holdSince > 0.5 and not atTop then
            setHold(false)
            modeIdx = modeIdx % #MODES + 1
            inputLabel = MODES[modeIdx] .. "?"
            return
        end
    end

    -- ทำนายตำแหน่งปลาและโซนล่วงหน้า (y เพิ่ม = ลงล่าง) ปลาอยู่เหนือโซน -> กดยกโซนขึ้น
    local err = (fc + svf * CFG.LOOKAHEAD) - (zc + svz * CFG.LOOKAHEAD)
    if err < -CFG.DEADBAND then setHold(true) elseif err > CFG.DEADBAND then setHold(false) end
end)

-- ==================== รับสถานะจากเซิร์ฟเวอร์ ====================
conns[#conns + 1] = Remote.OnClientEvent:Connect(function(kind, a, b)
    if not alive then return end
    if kind == "state" then
        st, stSince = a, os.clock()
        token += 1
        local my = token
        if a ~= "reel" then
            fishObj, zoneObj, trackObj = nil, nil, nil
            lastZc, lastFc, lastT = nil, nil, nil
            setHold(false)
        end
        if a == "waiting" then
            castPending = false
            if running then onWater(type(b) == "table" and b.water or nil) end
        elseif a == "bite" then
            castPending = false
            if running then
                task.delay(rnd(CFG.HOOK_DELAY), function()
                    if running and token == my and st == "bite" then Remote:FireServer("hook") end
                end)
            end
        elseif a == "reel" then
            castPending = false
            fishObj, zoneObj, trackObj = nil, nil, nil
            if running and S.fastReel and type(b) == "table" then   -- ทดลอง: ส่ง reel หลังเวลาขั้นต่ำ
                local mt = tonumber(b.minTime) or 2.2
                task.delay(mt + 0.3 + math.random() * 0.3, function()
                    if running and token == my and st == "reel" then Remote:FireServer("reel", true) end
                end)
            end
        elseif a == "idle" then
            local base = os.clock() + rnd(CFG.RECAST_WAIT)
            if castPending and running then
                castPending = false
                onFail("เซิร์ฟเวอร์ไม่รับการเหวี่ยง", true)
                lastDone = math.max(lastDone, base)
            else
                lastDone = base
            end
        end
    elseif kind == "caught" then
        caught += 1; fishSinceSell += 1
        streak, failCount = 0, 0
    end
end)

local function fishRun(v)
    running = v
    if not v then setHold(false); castPending = false end
    if v then lastDone = 0; failCount, streak = 0, 0 end
end

local function pauseFish()
    fishRun(false)
    Remote:FireServer("cancel")
    local t0 = os.clock()
    while os.clock() - t0 < 3 and st ~= "idle" do task.wait(0.1) end
    st, stSince, castPending = "idle", os.clock(), false
end

local function resumeFish()
    st, stSince, castPending = "idle", os.clock(), false
    lastDone = os.clock() + 1
    fishRun(true)
end

-- ลูปตกปลาหลัก
task.spawn(function()
    while alive do
        task.wait(0.25)
        if running then
            local now = os.clock()
            if st == "idle" and now >= lastDone then
                if ensureRod() then
                    st, stSince = "casting", now
                    castPending, castAt = true, now
                    Remote:FireServer("cast", CFG.CAST_MIN + math.random() * (CFG.CAST_MAX - CFG.CAST_MIN))
                else
                    onFail("ไม่พบ/ถือเบ็ด" .. (ROD_NAME[curRod()] or curRod()) .. " ไม่ได้", true)
                    lastDone = math.max(lastDone, now + 2)
                end
            elseif castPending and (st == "casting" or st == "flying") and now - castAt > CFG.CAST_TIMEOUT then
                castPending = false
                onFail("เหวี่ยงแล้วไม่มีการตอบสนอง")
            elseif st == "reel" and now - stSince > CFG.REEL_LIMIT then
                setHold(false); Remote:FireServer("cancel")
                st, stSince, lastDone = "idle", now, now + 1.5
                setStatus("มินิเกมนานเกิน — ยกเลิก")
            elseif st ~= "idle" and st ~= "reel" and not castPending and now - stSince > CFG.WATCHDOG then
                Remote:FireServer("cancel")
                st, stSince, lastDone = "idle", now, now + 1.5
                setStatus("ค้าง — ยกเลิกแล้วเริ่มใหม่")
            end
        end
    end
end)

-- ==================== เดินทาง (วาป / เดินไว) ====================
local function warpTo(cf)
    local r = root(); if not r then return false end
    for _ = 1, 2 do
        pcall(function()
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end)
        r.CFrame = cf
        task.wait(0.05)
    end
    return true
end

local function walkTo(cf)
    local h, r = hum(), root()
    if not (h and r) then return end
    local target = cf.Position
    local old = h.WalkSpeed
    h.WalkSpeed = CFG.WALK_SPEED
    local t0 = os.clock()
    local function moveTo(pos, limit)
        local done = false
        local c = h.MoveToFinished:Connect(function() done = true end)
        h:MoveTo(pos)
        local ts = os.clock()
        local r0 = root()
        local lastP, lastT = r0 and r0.Position, os.clock()
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        while not done and alive and os.clock() - ts < limit and os.clock() - t0 < CFG.WALK_TIMEOUT do
            task.wait(0.05)
            local rr = root()
            if rr and (rr.Position - pos).Magnitude < 3 then break end
            if rr then
                -- เช็กกำแพง/สิ่งกีดขวางข้างหน้า -> กระโดด
                local flat = Vector3.new(pos.X - rr.Position.X, 0, pos.Z - rr.Position.Z)
                if flat.Magnitude > 1 then
                    rp.FilterDescendantsInstances = {lp.Character}
                    local hit = workspace:Raycast(rr.Position - Vector3.new(0, 1.5, 0), flat.Unit * 3.5, rp)
                    if hit and hit.Instance.CanCollide then h.Jump = true end
                end
                -- ขยับน้อยมากเกิน 0.5 วิ = ติด -> กระโดด
                local now = os.clock()
                if now - lastT >= 0.5 then
                    if lastP and (Vector3.new(rr.Position.X, 0, rr.Position.Z) - Vector3.new(lastP.X, 0, lastP.Z)).Magnitude < 1 then
                        h.Jump = true
                    end
                    lastP, lastT = rr.Position, now
                end
            end
        end
        c:Disconnect()
    end
    pcall(function()
        local path = PathfindingService:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true})
        path:ComputeAsync(r.Position, target)
        if path.Status == Enum.PathStatus.Success then
            for _, wp in ipairs(path:GetWaypoints()) do
                if not alive or os.clock() - t0 > CFG.WALK_TIMEOUT then break end
                if wp.Action == Enum.PathWaypointAction.Jump then h.Jump = true end
                moveTo(wp.Position, 2.5)
            end
        else
            moveTo(target, 12)
        end
    end)
    pcall(function() h.WalkSpeed = old end)
end

-- snap=true: ปรับตำแหน่ง+ทิศหันให้ตรงกับ cf เป๊ะ (ใช้กับจุดฟาม)
local function travel(cf, snap)
    if not root() then return false end
    if S.mode == "walk" then
        walkTo(cf)
        local r = root()
        if r and (r.Position - cf.Position).Magnitude > 8 then warpTo(cf) end
        if snap then warpTo(cf) end
    else
        warpTo(cf)
    end
    return true
end

-- ==================== กระเป๋า / เหรียญ ====================
local function bagLabel()
    local g = lp.PlayerGui:FindFirstChild("FoxFish")
    local top = g and g:FindFirstChild("Top")
    local b = top and top:FindFirstChild("FishBag")
    local l = b and b:FindFirstChild("TextLabel")
    if l and l:IsA("TextLabel") then
        local c, m = l.Text:match("(%d+)%s*/%s*(%d+)")
        if c then return tonumber(c), tonumber(m) end
    end
end

local function readCoins()
    local g = lp.PlayerGui:FindFirstChild("FoxFish")
    local top = g and g:FindFirstChild("Top")
    local c = top and top:FindFirstChild("Coins")
    local l = c and c:FindFirstChild("TextLabel")
    if l and l:IsA("TextLabel") then return tonumber((l.Text:gsub("[^%d]", ""))) end
end

local function countFish(res, seen, depth)
    seen, depth = seen or {}, depth or 0
    if type(res) ~= "table" or seen[res] or depth > 6 then return 0 end
    seen[res] = true
    local id = res.u or res.uid or res.id
    local sp = res.s or res.species or res.name or res.fish
    if id ~= nil and sp ~= nil then return 1 end
    local n = 0
    for _, v in pairs(res) do n += countFish(v, seen, depth + 1) end
    return n
end

local function bagCountRemote()
    local ok, res = pcall(function() return Req:InvokeServer("bag") end)
    if ok then return countFish(res) end
end

local function bagNearFull()
    local c, m = bagLabel()
    if c and m then return c >= m - CFG.SELL_MARGIN end
    return fishSinceSell >= CFG.FALLBACK_MAX - CFG.SELL_MARGIN
end

-- ==================== ปุ่มโต้ตอบ (FoxPrompt) / หน้าร้าน ====================
local function promptButton()
    local g = lp.PlayerGui:FindFirstChild("FoxPrompt")
    local f = g and g:FindFirstChild("Frame")
    local b = f and f:FindFirstChild("TextButton")
    if b and f.Visible and b.Visible and g.Enabled ~= false then return b end
end

local function nearestPrompt(pos, maxDist)
    local best, bd
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local p = d.Parent
            local part = p and (p:IsA("BasePart") and p or (p:IsA("Attachment") and p.Parent)
                or p:FindFirstChildWhichIsA("BasePart", true))
            if part and part:IsA("BasePart") then
                local dist = (part.Position - pos).Magnitude
                if dist < maxDist and (not bd or dist < bd) then best, bd = d, dist end
            end
        end
    end
    return best
end

-- กดปุ่มโต้ตอบ (FoxPrompt) ให้ "เปิดร้านจริง" — ลองทีละวิธีแล้วเช็กด้วย verify() ว่าเปิดแล้วหรือยัง
local function usePrompt(pos, timeout, verify)
    if verify() then return true end
    local t0, btn = os.clock(), nil
    while os.clock() - t0 < timeout do
        btn = promptButton()
        if btn then break end
        task.wait(0.1)
    end
    local tries = {}
    tries[1] = function()   -- ลอง ProximityPrompt ก่อน (ไม่ต้องคลิกจอ)
        local p = nearestPrompt(pos, 25)
        if p and type(fireproximityprompt) == "function" then
            p.HoldDuration = 0
            fireproximityprompt(p)
        end
    end
    if btn then
        local x, y = screenPoint(btn, btn:FindFirstAncestorOfClass("ScreenGui"))
        tries[#tries + 1] = function() clickGui(btn) end
        tries[#tries + 1] = function()   -- ปุ่มโต้ตอบแบบกด: InputBegan -> InputEnded
            callConns(btn.InputBegan, fakeInput(Enum.UserInputState.Begin, x, y), false)
            task.wait(0.15)
            callConns(btn.InputEnded, fakeInput(Enum.UserInputState.End, x, y), false)
        end
        if VIM and safePoint(btn) then
            tries[#tries + 1] = function()
                VIM:SendMouseButtonEvent(x, y, 0, true, game, 0); task.wait(0.12)
                VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
            end
            tries[#tries + 1] = function()
                VIM:SendTouchEvent(88, 0, x, y); task.wait(0.12)
                VIM:SendTouchEvent(88, 2, x, y)
            end
        end
    end
    for _, fn in ipairs(tries) do
        pcall(fn)
        local t1 = os.clock()
        while os.clock() - t1 < 1.0 do
            task.wait(0.1)
            if verify() then return true end
        end
    end
    return verify()
end

