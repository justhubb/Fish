local function setEnabled(v)
	if v == enabled then
		return
	end
	enabled = v
	if enabled then
		failStreak, idleMiss, watchdogResets = 0, 0, 0
		cycleDone = true
		touch()
		log("เริ่มตกปลาอัตโนมัติ")
		setStatus("เริ่ม")
		flash("เริ่มตกปลาอัตโนมัติแล้ว")
	else
		activeChallenge = nil
		log("หยุดตกปลา")
		updateUi()
		flash("หยุดตกปลาแล้ว")
	end
end

