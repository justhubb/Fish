updateUi = function()
	if not running then
		return
	end
	local dot
	if rejoining then
		dot = C.warn
	elseif enabled then
		dot = busy and C.warn or C.success
	else
		dot = C.mutedFg
	end
	statusDot.BackgroundColor3 = dot
	headDot.BackgroundColor3 = dot
	if rejoining then
		lblStatus.Text = statusText
	elseif enabled then
		lblStatus.Text = "กำลังทำงาน  ·  " .. statusText
	elseif manualRun then
		lblStatus.Text = "ซื้อ/ขายแบบสั่งเอง  ·  " .. statusText
	else
		lblStatus.Text = "หยุดอยู่  ·  แตะปุ่มเริ่มด้านล่าง"
	end
	lblStatus.TextColor3 = enabled and C.fg or C.mutedFg
	statVals.catch.Text = tostring(catches)
	statVals.coin.Text = tostring(coinsEarned)
	statVals.trip.Text = tostring(trips)
	local bc = baitCount(S.bait)
	statVals.bait.Text = bc and tostring(bc) or "-"
	statVals.bait.TextColor3 = (bc and bc <= S.buyBelow) and C.danger or STAT_BASE.bait

	if enabled then
		setBtnText(btnMain, "หยุดตกปลา", C.dangerFg)
		setGrad(mainGrad, { C.dangerTop, C.dangerBot })
		if not mainGrad then
			mainFill.BackgroundColor3 = C.dangerTop
		end
		mainStroke.Color = C.danger
		glowColor(mainGlow, C.danger, 0.05)
	else
		setBtnText(btnMain, "เริ่มตกปลาอัตโนมัติ", C.white)
		setGrad(mainGrad, { C.primary, C.fuchsia })
		if not mainGrad then
			mainFill.BackgroundColor3 = C.primary
		end
		mainStroke.Color = C.lilac
		glowColor(mainGlow, C.violet, 0.06)
	end

	if S.home then
		local d = homeDistance()
		lblHome.Text = string.format("X %.0f   Y %.0f   Z %.0f   ·   ห่าง %s   ·   กลับมาแล้ว %d ครั้ง",
			S.home.x, S.home.y, S.home.z, d and string.format("%.1f", d) or "-", homeReturns)
		lblHome.TextColor3 = C.fg
	else
		lblHome.Text = "ยังไม่ตั้งจุด  ·  จะจำให้เองตอนเหวี่ยงครั้งแรก"
		lblHome.TextColor3 = C.mutedFg
	end
	local held = getRod()
	if held then
		lblRod.Text = "เบ็ดที่ใช้:  " .. rodPretty(held.Name) .. "  ·  ถืออยู่"
		lblRod.TextColor3 = C.fg
	elseif S.rodId then
		lblRod.Text = "เบ็ดที่ใช้:  " .. rodPretty(S.rodId) .. "  ·  จะถือให้เองตอนเริ่ม"
		lblRod.TextColor3 = C.fg
	else
		lblRod.Text = "เบ็ด: ถือเบ็ดที่อยากใช้ไว้ สคริปต์จะจำเอง (ใช้ได้ทุกเบ็ด)"
		lblRod.TextColor3 = C.mutedFg
	end
	if lblAfkDesc then
		lblAfkDesc.Text = afkPings > 0 and ("ทำงานแล้ว " .. afkPings .. " ครั้ง") or "กันโดนเตะเมื่อยืนนิ่งนาน"
	end
	for _, r in ipairs(renders) do
		r()
	end
end

