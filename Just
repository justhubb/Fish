-- เบ็ดทุกแบบ: Tool ในมือชื่อเดียวกับ id ในกระเป๋า เช่น fishing_rod, rod_seraph_v2, rod_dragon
-- id ในกระเป๋าอาจมีระดับอัปเกรดต่อท้าย เช่น rod_trex+5
local function rodBase(id)
	return (tostring(id or ""):gsub("%+%d+$", ""))
end
local function isRodId(name)
	if type(name) ~= "string" or name == "" then
		return false
	end
	if CFG.ROD_NAME ~= "" then
		return rodBase(name) == rodBase(CFG.ROD_NAME)
	end
	local l = name:lower()
	return l == "fishing_rod" or l:sub(1, 4) == "rod_" or l:find("rod", 1, true) ~= nil
end
local function rodPretty(id)
	if not id then
		return "-"
	end
	local base = rodBase(id)
	if base == "fishing_rod" then
		return "เบ็ดเริ่มต้น"
	end
	local plus = tostring(id):match("%+(%d+)$")
	local name = base:gsub("^rod_", ""):gsub("_", " "):gsub("(%a)([%w]*)", function(a, b)
		return a:upper() .. b
	end)
	return name .. (plus and (" +" .. plus) or "")
end

local rodWarned = false
local function getRod()
	local char = lp.Character
	if not char then
		return nil
	end
	local anyTool = nil
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Tool") then
			if isRodId(c.Name) then
				if S.rodId == nil or rodBase(S.rodId) ~= rodBase(c.Name) then
					S.rodId = c.Name
					saveSettings()
					log("จำเบ็ดที่ใช้:", c.Name)
					updateUi()
				end
				return c
			end
			anyTool = anyTool or c
		end
	end
	-- ถือ Tool ชื่อแปลก แต่เกมแสดงปุ่มเหวี่ยงอยู่ = เกมถือว่าเป็นเบ็ด
	if anyTool then
		local pg = lp:FindFirstChild("PlayerGui")
		local hudGui = pg and pg:FindFirstChild("FishingHUD")
		local fishing = hudGui and hudGui:FindFirstChild("Fishing")
		local idle = fishing and fishing:FindFirstChild("Idle")
		if idle and idle.Visible then
			if not rodWarned then
				rodWarned = true
				log("ถือ Tool ชื่อ", anyTool.Name, "และเกมแสดงปุ่มเหวี่ยง ถือว่าเป็นเบ็ด")
