-- เดินไปที่จุด ทีละขั้น:
--   1) MoveTo ปกติ + Raycast เช็คกำแพงข้างหน้า: กำแพงเตี้ยกระโดด
--   2) กำแพงสูงขวาง หรือขยับไม่ได้ติดกัน / เดินนานเกิน WALK_TIMEOUT -> เปิด noclip เดินทะลุ
--   3) noclip แล้วยังไปไม่ถึง (ขยับไม่ได้ หรือเกิน NOCLIP_TIMEOUT) หรือตกลงไป -> วาร์ป CFrame
--   noclip ถูกปิดและคืนค่าเสมอเมื่อจบ ไม่ว่าจะสำเร็จ ล้มเหลว หรือ error
local function walkTo(pos, stopDist)
	local root, hum = getRoot(), getHum()
	if not (root and hum) then
		return false
	end
	if hum.SeatPart then
		hum.Sit = false
		task.wait(0.4)
	end
	local rp = rayParamsFor(lp.Character)
	local floorY = math.min(root.Position.Y, pos.Y) - CFG.FALL_DROP
	local vY = voidY()
	local t0 = os.clock()
	local lastMove, lastJump = 0, 0
	local lastCheck, lastPos = os.clock(), root.Position
	local stuck, highHits = 0, 0
	local noclipAt = nil
	local result = false

	local function escalate(why)
		if not noclipAt then
			noclipAt = os.clock()
			setNoclip(true, why)
			lastCheck, lastPos = os.clock(), getRoot() and getRoot().Position or lastPos
		end
	end
	local function lastResort(why)
		if CFG.ALLOW_TELEPORT then
			return cfTo(pos, why)
		end
		log("ไปไม่ถึง (" .. why .. ") และปิดการวาร์ปไว้")
		return false
	end

	local ok, err = pcall(function()
		while canRun() do
			root, hum = getRoot(), getHum()
			if not (root and hum) or hum.Health <= 0 then
				result = false
				return
			end
			local p = root.Position
			if flatDist(p, pos) <= stopDist and math.abs(p.Y - pos.Y) < 12 then
				result = true
				return
			end
			-- ตกลงไป (ต่ำกว่าจุดเริ่ม/ปลายทางมาก หรือใกล้ขอบล่างของแมพ)
			if p.Y < floorY or p.Y < vY then
				log(string.format("ตกลงไป (Y %.0f)", p.Y))
				result = lastResort("ตก")
				return
			end
			if noclipAt then
				applyNoclip()
				if os.clock() - noclipAt > CFG.NOCLIP_TIMEOUT then
					result = lastResort("noclip แล้วยังไปไม่ถึง")
					return
				end
			elseif os.clock() - t0 > CFG.WALK_TIMEOUT then
				escalate("เดินนานเกิน " .. CFG.WALK_TIMEOUT .. " วินาที")
			end
			if os.clock() - lastMove > 1 then
				lastMove = os.clock()
				hum:MoveTo(pos)
			end
			-- เช็คกำแพง (เฉพาะตอนยังไม่ noclip)
			if not noclipAt then
				local w = wallAhead(root, rp, pos)
				if w == "low" then
					highHits = 0
					if os.clock() - lastJump > 0.8 then
						lastJump = os.clock()
						hum.Jump = true
					end
				elseif w == "high" then
					highHits = highHits + 1
					if highHits >= 3 then
						escalate("กำแพงสูงขวางทาง")
					end
				else
					highHits = 0
				end
			end
			-- ตรวจว่าติด: STUCK_CHECK วินาทีขยับไม่ถึง 1 stud
			if os.clock() - lastCheck > CFG.STUCK_CHECK then
				local moved = flatDist(root.Position, lastPos)
				lastCheck, lastPos = os.clock(), root.Position
				if moved < 1 then
					stuck = stuck + 1
					if noclipAt then
						if stuck >= 2 then
							result = lastResort("ติดแม้ noclip")
							return
						end
					else
						hum.Jump = true
						lastJump = os.clock()
						if stuck >= 2 then
							escalate("ติด ขยับไม่ได้")
							stuck = 0
						end
					end
				else
					stuck = 0
				end
			end
			task.wait(0.1)
		end
	end)
	setNoclip(false)
	if not ok then
		log("ระบบเดินขัดข้อง:", tostring(err))
		return false
	end
	return result
end

local function visit(shop)
	local pos = shopPos(shop)
	log(string.format("ไปร้าน %s ที่ (%.1f, %.1f, %.1f)", shop.id, pos.X, pos.Y, pos.Z))
	return walkTo(pos, CFG.REACH)
end

local function sellKindsTable()
	local t = {}
	for _, k in ipairs(KIND_LIST) do
		t[k] = S.sellAll or S.sellKinds[k] == true
	end
	return t
end

local function anyKindSelected()
	if S.sellAll then
		return true
	end
	for _, k in ipairs(KIND_LIST) do
		if S.sellKinds[k] then
			return true
		end
	end
	return false
end

-- คืน true = ขายแล้ว / "nothing" = ไม่มีปลาในหมวดที่เลือก / false = ผิดพลาด
local function sellFish()
	if not anyKindSelected() then
		log("ขาย: ไม่ได้เลือกระดับปลาที่จะขายเลย")
		return "nothing"
	end
	local info, err = invoke("Info", SHOPS.fish.id)
	if not info then
		log("ขาย: Info ล้มเหลว", tostring(err))
		return false
	end
	local pick, err2 = invoke("SellPick", SHOPS.fish.id, sellKindsTable())
	if not pick then
		log("ขาย: SellPick ล้มเหลว", tostring(err2))
		return false
	end
	if pick.ok == false then
		log("ขาย: SellPick ไม่สำเร็จ:", tostring(pick.message))
		return false
	end
	if type(pick.total) == "number" and pick.total <= 0 then
		log("ขาย: ไม่มีปลาในหมวดที่เลือก")
		return "nothing"
	end
	local res, err3 = invoke("Sell", SHOPS.fish.id, "all", nil)
	if not res then
		log("ขาย: Sell ล้มเหลว", tostring(err3))
		return false
	end
	log("ขาย:", tostring(res.message), "coins=" .. tostring(res.coins), "ok=" .. tostring(res.ok))
	if res.ok ~= true then
		return false
	end
	if type(pick.total) == "number" then
		coinsEarned = coinsEarned + pick.total
	end
	return true
end

-- คืน true = ซื้อสำเร็จ / "full" = กระเป๋าเต็ม ต้องขายก่อน / false = ซื้อไม่ได้ (เช่น Coin ไม่พอ)
local function buyBait()
	local b = baitInfo(S.bait)
	local info, err = invoke("Info", SHOPS.mart.id)
	if not info then
		log("ซื้อ: Info ล้มเหลว", tostring(err))
		return false
	end
	local coins = info.coins or 0
	local afford = math.floor(coins / b.price)
	local total = math.min(S.buyQty, afford)
	log(string.format("ซื้อ: %s ต้องการ %d ชิ้น Coin %d (ซื้อได้ %d)", b.name, S.buyQty, coins, afford))
	if total <= 0 then
		log("ซื้อ: Coin ไม่พอ")
		return false
	end
	local bought = 0
	while total > 0 and canRun() do
		local n = math.min(total, CFG.BUY_CHUNK)
		local res, err2 = invoke("Buy", SHOPS.mart.id, b.item, n)
		if not res then
			log("ซื้อ: Buy ล้มเหลว", tostring(err2))
			return bought > 0
		end
		if res.ok ~= true then
			log("ซื้อ: ไม่สำเร็จ:", tostring(res.message))
			if type(res.message) == "string" and res.message:find("กระเป๋า", 1, true) then
				return "full"
			end
			return bought > 0
		end
		bought = bought + n
		total = total - n
		task.wait(0.3)
	end
	log("ซื้อ: รวม", bought, "ชิ้น")
	return bought > 0
end

local function wantSell()
	if not S.autoSell or os.clock() < tradeBlockedUntilSell then
		return false
	end
	if pendingSell then
		return true
	end
	local free = freeSlots()
	return free ~= nil and free <= CFG.SELL_WHEN_FREE_SLOTS
end

local function wantBuy()
	if not S.autoBuy or not shopRemotes or os.clock() < tradeBlockedUntilBuy then
		return false
	end
	local have = baitCount(S.bait)
	return have ~= nil and have <= S.buyBelow
end

-- เที่ยวซื้อ/ขาย: เดินไปร้าน -> ทำรายการ -> เดินกลับจุดเดิม (ห่อด้วย pcall ใน runTrade)
local function doTrade(needSell, needBuy)
	local tStart = os.clock()
	local root = getRoot()
	if not root then
		return
	end
	local home = homeCFrame() or root.CFrame
	trips = trips + 1
	local sellOk, buyOk = true, true

	local function timeUp()
		return os.clock() - tStart > CFG.TRADE_MAX
	end

	if needSell and shopRemotes then
		setStatus("ไปขายปลา")
		if visit(SHOPS.fish) then
			local r = sellFish()
			if r == "nothing" then
				tradeBlockedUntilSell = os.clock() + CFG.TRADE_COOLDOWN
				log("ไม่มีปลาให้ขายตามหมวดที่เลือก พักการขาย", CFG.TRADE_COOLDOWN, "วินาที")
			end
			sellOk = (r == true or r == "nothing")
		else
			sellOk = false
		end
	end

	if needBuy and canRun() and not timeUp() and shopRemotes then
		setStatus("ไปซื้อเหยื่อ")
		if visit(SHOPS.mart) then
			local r = buyBait()
			if r == "full" and S.autoSell and not timeUp() then
				-- ซื้อไม่ได้เพราะกระเป๋าเต็ม: ไปขายปลาก่อนแล้วกลับมาซื้อใหม่
				setStatus("กระเป๋าเต็ม ไปขายปลาก่อน")
				if visit(SHOPS.fish) and sellFish() == true and visit(SHOPS.mart) then
					r = buyBait()
				end
			end
			buyOk = (r == true)
		else
			buyOk = false
		end
	end

	if not sellOk then
		tradeBlockedUntilSell = os.clock() + CFG.TRADE_COOLDOWN
	end
	if not buyOk then
		tradeBlockedUntilBuy = os.clock() + CFG.TRADE_COOLDOWN
		log("ซื้อเหยื่อไม่สำเร็จ พักการซื้อ", CFG.TRADE_COOLDOWN, "วินาที")
	end

	-- กลับจุดตกปลา และหันทิศเดิม (ทิศการเหวี่ยงขึ้นกับทิศที่ตัวละครหัน)
	if canRun() then
		setStatus("กลับจุดตกปลา")
		local back = walkTo(home.Position, 3)
		local r2 = getRoot()
		if back and r2 then
			r2.CFrame = home
		else
			log("กลับจุดเดิมไม่ได้")
		end
	end
end

local function runTrade(needSell, needBuy)
	busy = true
	local ok, err = pcall(doTrade, needSell, needBuy)
	busy = false
	if not ok then
		log("ขัดข้องระหว่างซื้อ/ขาย:", tostring(err))
		tradeBlockedUntilSell = os.clock() + CFG.TRADE_COOLDOWN
		tradeBlockedUntilBuy = os.clock() + CFG.TRADE_COOLDOWN
	end
	pendingSell = false
	touch()
	updateUi()
end

-- กระเป๋าเต็ม: ถ้าเปิดขายอัตโนมัติและไม่ถูกพัก ให้ไปขาย ไม่งั้นรอแล้วลองเหวี่ยงใหม่
local function handleFull()
	if S.autoSell and os.clock() >= tradeBlockedUntilSell then
		pendingSell = true
		setStatus("กระเป๋าเต็ม ไปขายปลา")
		task.wait(1)
	else
		setStatus("กระเป๋าเต็ม รอ")
		log("กระเป๋าเต็ม: ลองใหม่ใน", CFG.FULL_RETRY, "วินาที")
		task.wait(CFG.FULL_RETRY)
	end
end

-- ===================== ลูปหลัก =====================
-- หนึ่งรอบ: [ซื้อ/ขาย ถ้าจำเป็น] -> ถือเบ็ด -> เหวี่ยง -> รอจนจับได้
-- ทุกกรณีผิดปกติจบรอบแล้วให้ลูปลองใหม่เอง ไม่หยุดถาวร
local failStreak = 0
local idleMiss = 0

local function step()
	-- 0) เกมกำลังตกอยู่แล้ว (เช่น เหวี่ยงต่อให้เองหลังจับได้): รอ ไม่กดเหวี่ยงซ้ำ ไม่เดินหนี
	if casting and not forceTrade and os.clock() - lastFishEvent > CFG.STALE_CAST then
		-- server เงียบนานเกินรอบปกติ (เช่น หยุดกลางรอบแล้วปลาหนีไป): ถือว่าไม่ได้ตกอยู่แล้ว
		log("สถานะกำลังตกค้าง", math.floor(os.clock() - lastFishEvent), "วินาที รีเซ็ตแล้วเหวี่ยงใหม่")
		casting = false
		local idle = getIdle()
		if not (idle and idle.Visible) then
			pressCastButton()
			task.wait(1)
		end
	end
	if casting and not forceTrade then
		-- ไม่เรียก setStatus/touch ที่นี่ เพื่อให้ watchdog จับได้ถ้า casting ค้างเพราะพลาด event
		statusText = "รอปลากิน"
		updateUi()
		task.wait(0.5)
		return
	end

	-- 1) ซื้อ/ขาย (เหยื่อหมดซื้อทันที, กระเป๋าเต็มขายทันที)
	local needSell, needBuy = false, false
	if forceTrade then
		needSell, needBuy = shopRemotes ~= nil, shopRemotes ~= nil
		forceTrade = false
	else
		needSell, needBuy = wantSell(), wantBuy()
	end
	if needSell or needBuy then
		runTrade(needSell, needBuy)
		return
	end

	-- 2) ถือเบ็ด
	if not getRod() then
		setStatus("ถือเบ็ด")
		if not equipRod() then
			failStreak = failStreak + 1
			setStatus("ถือเบ็ดไม่ได้ ลองใหม่")
			task.wait(3)
			return
		end
	end

	-- 3) รอปุ่มเหวี่ยง
	setStatus("รอปุ่มเหวี่ยง")
	if not waitIdleVisible(CFG.IDLE_TIMEOUT) then
		idleMiss = idleMiss + 1
		log("ปุ่มเหวี่ยง (Idle) ไม่แสดงภายใน", CFG.IDLE_TIMEOUT, "วินาที ครั้งที่", idleMiss)
		if idleMiss >= 3 then
			-- น่าจะค้างสถานะเหวี่ยงอยู่: กดปุ่มเหวี่ยงของเกมเพื่อยกเลิก/รีเซ็ต
			log("ค้าง: ลองกดปุ่มเหวี่ยงเพื่อรีเซ็ต")
			pressCastButton()
			idleMiss = 0
			task.wait(1)
		end
		return
	end
	idleMiss = 0

	-- 4) เหวี่ยง
	cycleDone, cycleReason = false, nil
	setStatus("เหวี่ยง")
	if not cast() then
		if cycleReason == "full" then
			handleFull()
			return
		end
		failStreak = failStreak + 1
		local backoff = math.min(CFG.FAIL_BACKOFF * failStreak, 10)
		setStatus("เหวี่ยงไม่ติด ลองใหม่")
		log("เหวี่ยงไม่สำเร็จติดกัน", failStreak, "ครั้ง พัก", backoff, "วินาที (ตรวจเหยื่อ/ที่ยืนใกล้น้ำ)")
		task.wait(backoff)
		return
	end
	failStreak = 0
	if not S.home then
		setHomeHere("ตั้งจุดตกปลาอัตโนมัติ")
	end

	-- 5) รอจนจับได้
	local t0 = os.clock()
	while canRun() and not cycleDone and os.clock() - t0 < CFG.CYCLE_TIMEOUT do
		task.wait(0.2)
	end
	if enabled and not cycleDone then
		log("รอบนี้เกินเวลา", CFG.CYCLE_TIMEOUT, "วินาทีโดยไม่จบ รีเซ็ตแล้วเหวี่ยงใหม่")
		local idle = getIdle()
		if not (idle and idle.Visible) then
			pressCastButton()
		end
		task.wait(1)
	end

	if cycleReason == "full" then
		handleFull()
	else
		task.wait(CFG.RECAST_DELAY)
	end
end

task.spawn(function()
	while running do
		if enabled and not busy then
			local ok, err = pcall(step)
			if not ok then
				log("ขัดข้องในลูป:", tostring(err))
				task.wait(2)
			end
		else
			task.wait(0.3)
		end
	end
	copyLog()
end)

-- ===================== ระบบเฝ้าระวัง (watchdog) =====================
-- ไม่มีความคืบหน้า (event จาก server / การกด / ขั้นตอนซื้อขาย) เกิน WATCHDOG วินาที = ค้าง -> กู้
task.spawn(function()
	while running do
		task.wait(2)
		if enabled and not busy and os.clock() - lastProgress > CFG.WATCHDOG then
			watchdogResets = watchdogResets + 1
			log("WATCHDOG: ไม่มีความคืบหน้า", math.floor(os.clock() - lastProgress), "วินาที กู้ครั้งที่", watchdogResets)
			activeChallenge = nil
			castConfirmed = false
			casting = false
			cycleDone = true -- ปลุกลูปที่รออยู่ให้เริ่มรอบใหม่
			local idle = getIdle()
			if not (idle and idle.Visible) then
				pressCastButton()
			end
			if watchdogResets >= 3 and not getRod() then
				local slot = rodSlot()
				if slot then
					bagAction:FireServer("use", slot)
				end
			end
			setStatus("ขัดข้อง กู้อัตโนมัติ")
			touch()
		end
	end
end)


-- ===================== กลับจุดเดิม (กันถูกชน/ถูกดัน/ตาย/หยุดพัก) =====================
-- ทุก GUARD_INTERVAL วินาที: ถ้าออโต้เปิดอยู่ ไม่ได้กำลังซื้อขาย ไม่ได้อยู่ในมินิเกม และไม่ได้นั่งเรือ
-- แล้วตัวละครห่างจุดตกปลาเกิน HOME_RADIUS ให้กลับจุดเดิมพร้อมหันทิศเดิม
local function returnHome(reason)
	local home = homeCFrame()
	local root, hum = getRoot(), getHum()
	if not (home and root and hum) then
		return false
	end
	local dist, dy = homeDistance()
	dist, dy = dist or 0, dy or 0
	homeReturns = homeReturns + 1
	log(string.format("กลับจุดเดิม (%s) ห่าง %.1f studs สูงต่างกัน %.1f", reason, dist, dy))
	if hum.Sit then
		hum.Sit = false
		task.wait(0.2)
	end
	busy = true
	setStatus("กลับจุดตกปลา")
	local ok, reached = true, true
	if dy > CFG.HOME_FALL_Y then
		-- หล่นจากจุด (ตกน้ำ/ตกชั้นล่าง) เดินกลับขึ้นไม่ได้: วาร์ปกลับทันที
		reached = CFG.ALLOW_TELEPORT and cfTo(home.Position, "หล่นจากจุดตกปลา") or false
	else
		ok, reached = pcall(walkTo, home.Position, 1.2)
	end
	busy = false
	root = getRoot()
	if not (ok and reached and root) then
		log("กลับจุดเดิมไม่สำเร็จ จะลองใหม่")
		return false
	end
	-- ถึงแล้ว: จัดตำแหน่งและทิศให้ตรงจุดเดิมเป๊ะ (ขยับไม่เกินไม่กี่ studs)
	root.CFrame = home
	pcall(function()
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end)
	touch()
	updateUi()
	return true
end

task.spawn(function()
	while running do
		task.wait(CFG.GUARD_INTERVAL)
		if enabled and S.returnHome and S.home and not busy and not manualRun and not activeChallenge then
			local hum = getHum()
			local dist, dy = homeDistance()
			if hum and not hum.SeatPart and hum.Health ~= 0 and dist and (dist > CFG.HOME_RADIUS or dy > 8) then
				local ok, err = pcall(returnHome, "ถูกดันหรือออกจากจุด")
				if not ok then
					log("กลับจุดเดิมขัดข้อง:", tostring(err))
				end
			end
		end
