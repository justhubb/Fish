		"bait=" .. S.bait,
		"buyQty=" .. tostring(S.buyQty),
		"buyBelow=" .. tostring(S.buyBelow),
		"returnHome=" .. (S.returnHome and "1" or "0"),
		"antiAfk=" .. (S.antiAfk and "1" or "0"),
		"autoRejoin=" .. (S.autoRejoin and "1" or "0"),
		"rodId=" .. (S.rodId or ""),
		"home=" .. (S.home and string.format("%.3f,%.3f,%.3f,%.4f,%.4f", S.home.x, S.home.y, S.home.z, S.home.lx, S.home.lz) or ""),
	}, "\n")
	pcall(writefile, CFG.SETTINGS_FILE, text)
end

local function loadSettings()
	if not (readfile and isfile) then
		return
	end
	local okExists, exists = pcall(isfile, CFG.SETTINGS_FILE)
	if not (okExists and exists) then
		return
	end
	local ok, text = pcall(readfile, CFG.SETTINGS_FILE)
	if not (ok and type(text) == "string") then
		return
	end
	for line in text:gmatch("[^\r\n]+") do
		local k, v = line:match("^(%w+)=(.*)$")
		if k == "autoSell" then
			S.autoSell = (v == "1")
		elseif k == "sellAll" then
			S.sellAll = (v == "1")
		elseif k == "kinds" then
			local set = {}
			for name in v:gmatch("[^,]+") do
				set[name] = true
			end
			for _, kk in ipairs(KIND_LIST) do
				S.sellKinds[kk] = set[kk] == true
			end
		elseif k == "autoBuy" then
			S.autoBuy = (v == "1")
		elseif k == "bait" then
			S.bait = baitInfo(v).id
		elseif k == "buyQty" then
			S.buyQty = clamp(math.floor(tonumber(v) or S.buyQty), 1, 9999)
		elseif k == "buyBelow" then
			S.buyBelow = clamp(math.floor(tonumber(v) or S.buyBelow), 0, 999)
		elseif k == "returnHome" then
			S.returnHome = (v == "1")
		elseif k == "antiAfk" then
			S.antiAfk = (v == "1")
		elseif k == "autoRejoin" then
			S.autoRejoin = (v == "1")
		elseif k == "rodId" then
			S.rodId = (v ~= "" and v) or nil
		elseif k == "home" then
			local x, y, z, lx, lz = v:match("^([%-%d%.]+),([%-%d%.]+),([%-%d%.]+),([%-%d%.]+),([%-%d%.]+)$")
			if x then
				S.home = { x = tonumber(x), y = tonumber(y), z = tonumber(z), lx = tonumber(lx), lz = tonumber(lz) }
			end
		end
	end
end
