local bag = { capacity = nil, used = nil, slots = nil }

local function freeSlots()
	if bag.capacity and bag.used then
		return bag.capacity - bag.used
	end
	return nil
end

local function bagCount(id)
	if type(bag.slots) == "table" then
		for _, s in pairs(bag.slots) do
			if type(s) == "table" and s.id == id then
				return s.n or 0
			end
		end
		return 0
	end
	return nil
end

