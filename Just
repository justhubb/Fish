-- ===================== แก้มินิเกมจากข้อมูล challenge =====================
local activeChallenge = nil

local function validRound(r)
	return type(r) == "table" and type(r.speed) == "number" and r.speed > 0
		and type(r.phase) == "number" and type(r.c) == "number" and type(r.half) == "number"
end

local function solveChallenge(data, tRecv)
	if type(data) ~= "table" or type(data.rounds) ~= "table" then
		log("challenge รูปแบบไม่ตรงที่คาด:", ser(data))
		return
	end
	activeChallenge = data.id
	local myId = data.id
	local t0 = tRecv + CFG.T0_OFFSET
	local roundStart = t0
	log(string.format("challenge id=%s rarity=%s rounds=%d maxMisses=%s", tostring(data.id), tostring(data.rarity), #data.rounds, tostring(data.maxMisses)))

	for i, r in ipairs(data.rounds) do
		if not (canRun() and activeChallenge == myId) then
			return
		end
		if not validRound(r) then
			log("รอบ", i, "ข้อมูลไม่ครบ:", ser(r))
			return
		end
		local w = 2 * r.speed
		local now = os.clock()
		local dmin = math.max(CFG.MIN_DT, now - roundStart + 0.05)
		local dt = timeToCenter(r.phase, w, r.c, dmin)
		if not dt then
			log("รอบ", i, "หาเวลากดไม่ได้")
			return
		end
		local target = roundStart + dt - CFG.AIM_BIAS
		while canRun() and activeChallenge == myId and os.clock() < target do
			RunService.Heartbeat:Wait()
		end
		local card = getHudCard()
		if not (canRun() and activeChallenge == myId and card) then
			log("รอบ", i, "ยกเลิก (HUD ปิดหรือ challenge เปลี่ยน)")
			return
		end
		local pressT = os.clock()
		local expect = needlePos(r.phase, w, pressT - roundStart)
		log(string.format("รอบ %d: กด dt=%.3f คาดว่าเข็ม=%.3f c=%.3f half=%.3f", i, pressT - roundStart, expect, r.c, r.half))
		pressPull(card)
		roundStart = pressT
		touch()
	end
end

