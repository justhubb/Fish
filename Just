local logBuf = {}
local function log(...)
	local parts = {}
	for i = 1, select("#", ...) do
		parts[i] = tostring((select(i, ...)))
	end
	local line = string.format("[%.2f] %s", os.clock() % 1000, table.concat(parts, " "))
	print("[AF]", line)
	logBuf[#logBuf + 1] = line
	if #logBuf > 400 then
		table.remove(logBuf, 1)
	end
end

local function copyLog()
	local text = table.concat(logBuf, "\n")
	if setclipboard then
		pcall(setclipboard, text)
	end
	if writefile then
		pcall(writefile, "af_log.txt", text)
	end
end

local function ser(v, depth)
	depth = depth or 0
	if type(v) == "table" then
		if depth >= 2 then
			return "{...}"
		end
		local parts = {}
		for k, x in pairs(v) do
			parts[#parts + 1] = tostring(k) .. "=" .. ser(x, depth + 1)
		end
		return "{" .. table.concat(parts, ", ") .. "}"
	end
	return tostring(v)
end

