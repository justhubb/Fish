-- ===================== สูตรเข็ม =====================
local function needlePos(phase, w, dt)
	local m = (phase + w * dt) % 2
	if m > 1 then
		return 2 - m
	end
	return m
end

-- เวลา dt (>= dmin) ที่เข็มผ่านตำแหน่ง c พอดี: m = c หรือ m = 2 - c (mod 2)
local function timeToCenter(phase, w, c, dmin)
	local best = nil
	for k = -1, 3 do
		local a, b = c + 2 * k, 2 - c + 2 * k
		for _, ts in ipairs({ a, b }) do
			local dt = (ts - phase) / w
			if dt >= dmin and (best == nil or dt < best) then
				best = dt
			end
		end
	end
	return best
end

