-- ดรอปดาวน์: กล่องเลือกมีปุ่ม V สีเด่นด้านขวา แต่ละดรอปดาวน์มีสีประจำ แต่ละตัวเลือกมีสีของตัวเอง
-- กางในที่ (ไม่ลอยทับ ไม่โดนตัดในส่วนเลื่อน) multi = เลือกได้หลายตัว
local function dropdown(card, def)
	local name, accent, accentDark = def.name, def.accent, def.accentDark
	local options, multi = def.options, def.multi
	local wrap = mk("Frame", { LayoutOrder = rowOrder(card), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, card)
	mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, wrap)

	local head = mk("TextButton", { Name = name, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, wrap)
	local field = mk("Frame", { Name = "Field", Size = UDim2.new(1, 0, 0, 48), Position = UDim2.fromOffset(0, 6), BackgroundColor3 = C.white, BorderSizePixel = 0 }, head)
	corner(field, 12)
	if not grad(field, 90, { rgb(26, 23, 54), C.field }) then
		field.BackgroundColor3 = C.field
	end
	local fieldStroke = stroke(field, accent, 1.2, 0.55)
	local strip = mk("Frame", { Size = UDim2.fromOffset(3, 26), Position = UDim2.new(0, 9, 0.5, -13), BackgroundColor3 = accent, BorderSizePixel = 0 }, field)
	corner(strip, 2)
	text(field, { Text = def.title, Font = FONT_B, TextSize = 13, Position = UDim2.fromOffset(20, 5), Size = UDim2.new(1, -140, 0, 18) })
	local value = text(field, { Name = "Value", Font = FONT_B, TextSize = 12, TextColor3 = accent, Position = UDim2.fromOffset(20, 24), Size = UDim2.new(1, -140, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd })
	-- จุดสีแสดงระดับที่เลือก (เฉพาะแบบเลือกหลายตัว)
	local dots = {}
	if multi then
		local dotRow = mk("Frame", { Size = UDim2.fromOffset(70, 8), Position = UDim2.new(1, -120, 0.5, -4), BackgroundTransparency = 1 }, field)
		local n = 0
		for _, o in ipairs(options) do
			if o.key ~= "ALL" then
				local d = mk("Frame", { Size = UDim2.fromOffset(7, 7), Position = UDim2.fromOffset(n * 10, 0), BackgroundColor3 = o.color or accent, BorderSizePixel = 0 }, dotRow)
				corner(d, 4)
				dots[o.key] = d
				n = n + 1
			end
		end
	end
	-- ปุ่ม V
	local vbtn = mk("TextButton", { Name = name .. "Chevron", Size = UDim2.fromOffset(40, 38), Position = UDim2.new(1, -45, 0.5, -19), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 3 }, field)
	local vfill = mk("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = C.white, BorderSizePixel = 0, ZIndex = 3 }, vbtn)
	corner(vfill, 10)
	if not grad(vfill, 135, { accent, accentDark }) then
		vfill.BackgroundColor3 = accent
	end
	stroke(vfill, C.white, 1, 0.75)
	local vglow = glow(vbtn, accent, 4, 2, 0.06, 10)
	local chev = chevron(vbtn, C.white)
	pressable(vbtn)

	local list = mk("Frame", { Name = name .. "List", LayoutOrder = 2, Size = UDim2.new(1, 0, 0, #options * 42 + 8), BackgroundColor3 = C.list, BorderSizePixel = 0, Visible = false }, wrap)
	corner(list, 12)
	stroke(list, accent, 1, 0.7)
	local gap = mk("Frame", { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 10), BackgroundTransparency = 1, Visible = false }, wrap)
	local items = {}
	for i, o in ipairs(options) do
		local col = o.color or accent
		local b = mk("TextButton", { Name = name .. "_" .. o.key, Size = UDim2.new(1, -8, 0, 38), Position = UDim2.fromOffset(4, 4 + (i - 1) * 42), BackgroundColor3 = col, BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, list)
		corner(b, 9)
		local tag = mk("Frame", { Size = UDim2.fromOffset(8, 8), Position = UDim2.new(0, 12, 0.5, -4), BackgroundColor3 = col, BorderSizePixel = 0 }, b)
		corner(tag, 4)
		local lbl = text(b, { Name = "Label", Text = o.text, TextSize = 13, Font = FONT_B, Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -110, 1, 0) })
		if o.sub then
			text(b, { Text = o.sub, TextSize = 11, TextColor3 = C.mutedFg, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -112, 0, 0), Size = UDim2.fromOffset(74, 38) })
		end
		local box = mk("Frame", { Size = UDim2.fromOffset(20, 20), Position = UDim2.new(1, -30, 0.5, -10), BackgroundColor3 = col, BackgroundTransparency = 1, BorderSizePixel = 0 }, b)
		corner(box, multi and 6 or 10)
		local boxStroke = stroke(box, C.mutedFg, 1.5, 0.2)
		local fill = mk("Frame", { Size = UDim2.fromOffset(10, 10), Position = UDim2.fromOffset(5, 5), BackgroundColor3 = col, BorderSizePixel = 0, Visible = false }, box)
		corner(fill, multi and 3 or 5)
		items[i] = { btn = b, fill = fill, box = box, stroke = boxStroke, lbl = lbl, key = o.key, color = col }
		b.Activated:Connect(function()
			def.onPick(o.key)
			saveSettings()
			if not multi then
				list.Visible, gap.Visible = false, false
				tween(chev, 0.2, { Rotation = 0 })
				fieldStroke.Transparency = 0.55
			end
			updateUi()
		end)
	end
	local function toggle()
		local open = not list.Visible
		list.Visible, gap.Visible = open, open
		tween(chev, 0.22, { Rotation = open and 180 or 0 }, Enum.EasingStyle.Back)
		fieldStroke.Transparency = open and 0.05 or 0.55
		glowColor(vglow, accent, open and 0.12 or 0.06)
	end
	head.Activated:Connect(toggle)
	vbtn.Activated:Connect(toggle)
	renders[#renders + 1] = function()
		local v, col = def.getValue()
		value.Text = v
		value.TextColor3 = col or accent
		for _, it in ipairs(items) do
			local on = def.isOn(it.key)
			it.fill.Visible = on
			it.stroke.Color = on and it.color or C.mutedFg
			it.box.BackgroundTransparency = on and 0.75 or 1
			it.lbl.TextColor3 = on and C.fg or C.mutedFg
			it.btn.BackgroundTransparency = on and 0.86 or 1
		end
		for key, d in pairs(dots) do
			d.BackgroundTransparency = def.isOn(key) and 0 or 0.85
		end
	end
	return head
end

-- แถวตัวเลข: ปุ่ม - / + กดง่ายบนมือถือ และพิมพ์ค่าเองได้
local function stepperRow(card, name, title, desc, get, set, step, lo, hi)
	local row = mk("Frame", { LayoutOrder = rowOrder(card), Size = UDim2.new(1, 0, 0, 58), BackgroundTransparency = 1 }, card)
	text(row, { Text = title, Font = FONT_B, TextSize = 14, Position = UDim2.fromOffset(0, 10), Size = UDim2.new(1, -130, 0, 20) })
	text(row, { Text = desc, TextSize = 11, TextColor3 = C.mutedFg, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, -130, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd })
	local function sbtn(nm, label, x)
		local b = gradButton(row, {
			name = nm,
			text = label,
			size = UDim2.fromOffset(38, 38),
			pos = UDim2.new(1, x, 0.5, -19),
			colors = { C.mutedTop, C.muted },
			stroke = C.violet,
			strokeT = 0.55,
			textSize = 18,
			rot = 90,
		})
		return b
	end
	local minus = sbtn(name .. "Minus", "-", -128)
	local plus = sbtn(name .. "Plus", "+", -38)
	local box = mk("TextBox", {
		Name = name .. "Box",
		Size = UDim2.fromOffset(44, 38),
		Position = UDim2.new(1, -86, 0.5, -19),
		BackgroundColor3 = C.field,
		Text = "",
		Font = FONT_H,
		TextSize = 14,
		TextColor3 = C.fg,
		ClearTextOnFocus = false,
	}, row)
	corner(box, 10)
	local boxStroke = stroke(box, C.violet, 1.2, 0.35)
	pcall(function()
		box.Focused:Connect(function()
			boxStroke.Color, boxStroke.Transparency = C.fuchsia, 0
		end)
	end)
	local function apply(n)
		set(clamp(math.floor(n), lo, hi))
		saveSettings()
		updateUi()
	end
	minus.Activated:Connect(function()
		apply(get() - step)
	end)
	plus.Activated:Connect(function()
		apply(get() + step)
	end)
	box.FocusLost:Connect(function()
		boxStroke.Color, boxStroke.Transparency = C.violet, 0.35
		local n = tonumber(box.Text)
		if n then
			apply(n)
		else
			updateUi() -- พิมพ์ไม่ใช่ตัวเลข: คืนค่าเดิม
		end
	end)
	renders[#renders + 1] = function()
		box.Text = tostring(get())
	end
end

