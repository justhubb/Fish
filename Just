local function firePress(card, mode)
	local btn = card:FindFirstChild("TextButton")
	if not btn then
		return false
	end
	if mode == "space" then
		local vim = game:GetService("VirtualInputManager")
		vim:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
		task.wait(0.03)
		vim:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
		return true
	end
	if not getconnections then
		return false
	end
	local sig = (mode == "activated") and btn.Activated or btn.InputBegan
	local fired = 0
	for _, c in ipairs(getconnections(sig)) do
		pcall(function()
			if mode == "activated" then
				c:Fire()
			else
				-- handler ของเกมตรวจ UserInputType เป็น MouseButton1 / Touch
				c:Fire({
					UserInputType = Enum.UserInputType.MouseButton1,
					UserInputState = Enum.UserInputState.Begin,
					KeyCode = Enum.KeyCode.Unknown,
				}, false)
			end
		end)
		fired = fired + 1
	end
	return fired > 0
end

local function pressPull(card)
	if firePress(card, CFG.PRESS_MODE) then
		return true
	end
	-- วิธีหลักไม่เจอ connection: ลองวิธีสำรองตามลำดับ
	for _, m in ipairs({ "input", "activated", "space" }) do
