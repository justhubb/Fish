local rejoining = false
local function queueSelf()
	local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
	if not (q and readfile and isfile) then
		return false
	end
	local okExists, exists = pcall(isfile, CFG.SCRIPT_FILE)
	if not (okExists and exists) then
		return false
	end
	local ok, src = pcall(readfile, CFG.SCRIPT_FILE)
	if not (ok and type(src) == "string" and #src > 0) then
		return false
	end
	return pcall(q, src)
end

local function startRejoin(reason)
	if rejoining or not running or not S.autoRejoin then
		return
	end
	rejoining = true
	log("หลุดจากเซิร์ฟเวอร์:", tostring(reason), "เข้าใหม่ใน", CFG.REJOIN_DELAY, "วินาที")
	saveSettings()
	if writefile then
		pcall(writefile, CFG.RESUME_FILE, tostring(os.time()) .. ":" .. (enabled and "1" or "0"))
	end
	log(queueSelf() and "ตั้งให้สคริปต์รันต่อหลังเข้าเกมใหม่แล้ว" or ("ไม่พบ " .. CFG.SCRIPT_FILE .. " สคริปต์จะไม่รันต่อเอง (ใช้ autoexec แทน)"))
	statusText = "หลุด กำลังเข้าเกมใหม่"
	updateUi()
	task.spawn(function()
		task.wait(CFG.REJOIN_DELAY)
		while running and S.autoRejoin do
			local ok, err = pcall(function()
				game:GetService("TeleportService"):Teleport(game.PlaceId, lp)
			end)
			log("เข้าเกมใหม่:", ok and "ส่งคำขอแล้ว" or tostring(err))
			task.wait(CFG.REJOIN_RETRY)
		end
		rejoining = false
	end)
end

