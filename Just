-- เรียก InvokeServer พร้อม timeout กันค้างตลอดไป
local function invoke(name, ...)
	local r = shopRemotes and shopRemotes:FindFirstChild(name)
	if not r then
		return nil, "ไม่พบ ShopRemotes." .. name
	end
	local args = table.pack(...)
	local done, ok, res = false, false, nil
	task.spawn(function()
		ok, res = pcall(function()
			return r:InvokeServer(table.unpack(args, 1, args.n))
		end)
		done = true
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < CFG.INVOKE_TIMEOUT do
		task.wait(0.05)
	end
	touch()
	if not done then
		return nil, "timeout"
	end
	if not ok then
		return nil, tostring(res)
	end
	return res
end

