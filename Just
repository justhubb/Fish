local function gradButton(parent, props)
	local b = mk("TextButton", {
		Name = props.name,
		Size = props.size,
		Position = props.pos or UDim2.fromOffset(0, 0),
		AnchorPoint = props.anchor or Vector2.new(0, 0),
		BackgroundTransparency = 1,
		Text = props.text or "",
		TextTransparency = 1,
		TextSize = 1,
		AutoButtonColor = false,
		LayoutOrder = props.order or 0,
	}, parent)
	local fill = mk("Frame", {
		Name = "Fill",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = C.white,
		BorderSizePixel = 0,
	}, b)
	corner(fill, props.radius or 10)
	local g = grad(fill, props.rot or 0, props.colors)
	if not g then
		fill.BackgroundColor3 = props.colors[1]
	end
	local st = props.stroke and stroke(fill, props.stroke, 1, props.strokeT or 0.4) or nil
	-- เงาสะท้อนแสงด้านบน (ครึ่งบนสว่างกว่าเล็กน้อย)
	local shine = mk("Frame", {
		Name = "Shine",
		Size = UDim2.new(1, 0, 0.5, 0),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
	}, fill)
	corner(shine, props.radius or 10)
	fadeGrad(grad(shine, 90, { C.white, C.white }), 0.2, 1)
	local lbl = text(b, {
		Name = "Label",
		Text = props.text or "",
		Font = FONT_B,
		TextSize = props.textSize or 13,
		TextColor3 = props.textColor or C.white,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 3,
	})
	pressable(b)
	return b, g, fill, st, lbl
end

