local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function corner(o, r)
	return mk("UICorner", { CornerRadius = UDim.new(0, r) }, o)
end
-- เส้นขอบ (ApplyStrokeMode = Border ไม่งั้นบนปุ่ม/ข้อความจะกลายเป็นขอบตัวอักษร)
local function stroke(o, color, thick, transp, onText)
	local st = mk("UIStroke", { Color = color, Thickness = thick or 1, Transparency = transp or 0 }, o)
	if not onText then
		pcall(function()
			st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		end)
	end
	return st
end
local function cseq(cols)
	if #cols == 1 then
		return ColorSequence.new(cols[1])
	end
	local kps = {}
	for i, c in ipairs(cols) do
		kps[i] = ColorSequenceKeypoint.new((i - 1) / (#cols - 1), c)
	end
	return ColorSequence.new(kps)
end
-- ไล่สี: คืน UIGradient หรือ nil ถ้าไม่รองรับ
local function grad(o, rot, cols)
	local g = nil
	pcall(function()
		g = mk("UIGradient", { Color = cseq(cols), Rotation = rot or 0 }, o)
	end)
	return g
end
local function setGrad(g, cols)
	if g then
		pcall(function()
			g.Color = cseq(cols)
		end)
	end
end
local function fadeGrad(g, a, b)
	if g then
		pcall(function()
			g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(1, b) })
		end)
	end
end
local function tween(o, t, props, style)
	local ok = pcall(function()
		TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
	end)
	if not ok then
		for k, v in pairs(props) do
			pcall(function()
				o[k] = v
			end)
		end
	end
end
local function text(parent, props)
	local base = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextSize = 13,
		TextColor3 = C.fg,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return mk("TextLabel", base, parent)
end

-- แสงเรือง: ซ้อนกรอบโปร่งใสหลายชั้นรอบ target (ไม่ต้องใช้รูป asset)
-- วางเป็น sibling ของ target ข้างหลัง (ZIndex ต่ำกว่า) ห้ามใช้กับลูกของ UIListLayout
local function glow(target, color, layers, step, alpha, radius, offsetY)
	local holder = nil
	pcall(function()
		holder = mk("Frame", {
			Name = "Glow",
			BackgroundTransparency = 1,
			Position = target.Position,
			Size = target.Size,
			AnchorPoint = target.AnchorPoint,
			ZIndex = math.max((target.ZIndex or 1) - 1, 0),
		}, target.Parent)
		holder:SetAttribute("layers", layers)
		for i = 1, layers do
			local f = mk("Frame", {
				Name = "L" .. i,
				BackgroundColor3 = color,
				BackgroundTransparency = 1 - alpha,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(-i * step, -i * step + (offsetY or 0)),
				Size = UDim2.new(1, i * step * 2, 1, i * step * 2),
				ZIndex = holder.ZIndex,
			}, holder)
			corner(f, radius + i * step)
		end
	end)
	return holder
end
local function glowColor(holder, color, alpha)
	if not holder then
		return
	end
	pcall(function()
		for _, f in ipairs(holder:GetChildren()) do
			if f:IsA("Frame") then
				f.BackgroundColor3 = color
				if alpha then
					f.BackgroundTransparency = 1 - alpha
				end
			end
		end
	end)
end

-- ยุบ/เด้งเมื่อแตะ ให้รู้สึกว่ากดโดน
local function pressable(btn)
	pcall(function()
		local sc = mk("UIScale", { Scale = 1 }, btn)
		btn.MouseButton1Down:Connect(function()
			tween(sc, 0.08, { Scale = 0.95 })
		end)
		local function up()
			tween(sc, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
		end
		btn.MouseButton1Up:Connect(up)
		btn.MouseLeave:Connect(up)
	end)
end

