	sellOptions[#sellOptions + 1] = { key = k, text = cap(k), color = TIER_COLOR[k] }
end
dropdown(cSell, {
	name = "SellKinds",
	title = "ระดับที่ขาย",
	accent = C.warn,
	accentDark = rgb(180, 83, 9),
	options = sellOptions,
	multi = true,
	getValue = function()
		if S.sellAll then
			return "ทั้งหมด", C.lilac
		end
		local names, first = {}, nil
		for _, k in ipairs(KIND_LIST) do
			if S.sellKinds[k] then
				names[#names + 1] = cap(k)
				first = first or TIER_COLOR[k]
			end
		end
		if #names == 0 then
			return "ยังไม่เลือก", C.danger
		end
		if #names > 2 then
			return names[1] .. " +" .. (#names - 1), first
		end
		return table.concat(names, ", "), first
	end,
	isOn = function(key)
		if key == "ALL" then
			return S.sellAll
		end
		return S.sellAll or S.sellKinds[key] == true
	end,
	onPick = function(key)
		if key == "ALL" then
			S.sellAll = not S.sellAll
			for _, k in ipairs(KIND_LIST) do
				S.sellKinds[k] = S.sellAll
			end
			return
		end
		if S.sellAll then
			-- เลือกทั้งหมดอยู่: แตะระดับไหน = เอาระดับนั้นออก
			S.sellAll = false
			for _, k in ipairs(KIND_LIST) do
				S.sellKinds[k] = (k ~= key)
			end
		else
			S.sellKinds[key] = not S.sellKinds[key]
			local all = true
			for _, k in ipairs(KIND_LIST) do
				if not S.sellKinds[k] then
					all = false
				end
			end
			S.sellAll = all
		end
	end,
})

