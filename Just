-- หมวด: หัวข้อมีแถบสี + การ์ดไล่สี มีเส้นแสงด้านบน
local function section(title, accent)
	accent = accent or C.violet
	local cap = mk("Frame", { LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1 }, scroll)
	local bar = mk("Frame", { Size = UDim2.fromOffset(3, 12), Position = UDim2.fromOffset(0, 5), BackgroundColor3 = accent, BorderSizePixel = 0 }, cap)
	corner(bar, 2)
	text(cap, { Text = title, Font = FONT_B, TextSize = 12, TextColor3 = C.lilac, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -10, 1, 0) })
	local line = mk("Frame", { Size = UDim2.new(1, -112, 0, 1), Position = UDim2.new(0, 112, 0.5, 0), BackgroundColor3 = accent, BorderSizePixel = 0 }, cap)
	fadeGrad(grad(line, 0, { accent, accent }), 0.5, 1)

	local card = mk("Frame", {
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.white,
		BorderSizePixel = 0,
	}, scroll)
	corner(card, 12)
	if not grad(card, 90, { C.cardTop, C.cardBot }) then
		card.BackgroundColor3 = C.card
	end
	stroke(card, accent, 1, 0.68)
	local hl = mk("Frame", { Name = "Highlight", Size = UDim2.new(1, -24, 0, 1), Position = UDim2.fromOffset(12, 0), BackgroundColor3 = C.white, BorderSizePixel = 0 }, card)
	pcall(function()
		local g = grad(hl, 0, { C.white, C.white, C.white })
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.75), NumberSequenceKeypoint.new(1, 1) })
	end)
	local content = mk("Frame", {
		Name = "Content",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, card)
	mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, content)
	mk("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 4) }, content)
	content:SetAttribute("rows", 0)
	return content
end

local function rowOrder(card)
	local n = (card:GetAttribute("rows") or 0) + 1
	card:SetAttribute("rows", n)
	if n > 1 then -- เส้นคั่นระหว่างแถว
		local d = mk("Frame", { LayoutOrder = n * 2 - 1, Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = C.divider, BorderSizePixel = 0 }, card)
		pcall(function()
			local g = grad(d, 0, { C.white, C.white, C.white })
			g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.3), NumberSequenceKeypoint.new(1, 1) })
			d.BackgroundColor3 = C.divider
		end)
	end
	return n * 2
end

-- สวิตช์: แตะได้ทั้งแถว แสดงตำแหน่งปุ่ม สี และคำว่า เปิด/ปิด (ไม่ใช้สีอย่างเดียว)
local function switchRow(card, name, title, desc, get, set)
	local h = desc and 54 or 46
	local row = mk("TextButton", { Name = name, LayoutOrder = rowOrder(card), Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, card)
	text(row, { Text = title, Font = FONT_B, TextSize = 14, Position = UDim2.fromOffset(0, desc and 8 or 0), Size = UDim2.new(1, -96, 0, desc and 20 or h) })
	local descLbl
	if desc then
		descLbl = text(row, { Name = "Desc", Text = desc, TextSize = 11, TextColor3 = C.mutedFg, Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, -96, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd })
	end
	local state = text(row, { Name = "State", TextSize = 11, Font = FONT_B, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -94, 0.5, -8), Size = UDim2.fromOffset(40, 16) })
	local track = mk("Frame", { Name = "Track", Size = UDim2.fromOffset(46, 26), Position = UDim2.new(1, -46, 0.5, -13), BackgroundColor3 = C.track, BorderSizePixel = 0, ZIndex = 2 }, row)
	corner(track, 13)
	local trackStroke = stroke(track, C.white, 1, 0.9)
	local trackGrad = grad(track, 0, { C.primary, C.fuchsia })
	if trackGrad then
		trackGrad.Enabled = false
	end
	local trackGlow = glow(track, C.fuchsia, 4, 2, 0.07, 13)
	if trackGlow then
		trackGlow.Visible = false
	end
	local knobHolder = mk("Frame", { Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(3, 3), BackgroundTransparency = 1, ZIndex = 3 }, track)
	local knobShadow = mk("Frame", { Size = UDim2.new(1, 2, 1, 2), Position = UDim2.fromOffset(-1, 1), BackgroundColor3 = C.black, BackgroundTransparency = 0.6, BorderSizePixel = 0, ZIndex = 3 }, knobHolder)
	corner(knobShadow, 11)
	local knob = mk("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = C.white, BorderSizePixel = 0, ZIndex = 4 }, knobHolder)
	corner(knob, 10)
	grad(knob, 90, { C.white, rgb(221, 214, 254) })
	local last = nil
	local function render()
		local on = get() and true or false
		if on == last then
			return
		end
		last = on
		state.Text = on and "เปิด" or "ปิด"
		state.TextColor3 = on and C.lilac or C.mutedFg
		if trackGrad then
			trackGrad.Enabled = on
			track.BackgroundColor3 = on and C.white or C.track
		else
			track.BackgroundColor3 = on and C.primary or C.track
		end
		trackStroke.Transparency = on and 0.6 or 0.9
		if trackGlow then
			trackGlow.Visible = on
		end
		tween(knobHolder, 0.22, { Position = UDim2.fromOffset(on and 23 or 3, 3) }, Enum.EasingStyle.Back)
	end
	row.Activated:Connect(function()
		set(not get())
		saveSettings()
		updateUi()
	end)
	renders[#renders + 1] = render
	return row, descLbl
end

