-- ---------- ระบบเดิน: เช็คกำแพง -> กระโดด -> noclip ชั่วคราว -> CFrame (ทางสุดท้าย) ----------
-- noclip: ปิด CanCollide ของชิ้นส่วนตัวละครทุกเฟรม (Humanoid คืนค่าเองทุกเฟรม จึงต้องทำซ้ำ)
-- จำเฉพาะชิ้นที่เราปิดไว้ แล้วคืนค่าเดิมทันทีที่ถึงจุด / หยุด / ตาย / ปิดสคริปต์
local noclipSaved, noclipConn = nil, nil
local function applyNoclip()
	local c = lp.Character
	if not (c and noclipSaved) then
		return
	end
	for _, part in ipairs(c:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			if noclipSaved[part] == nil then
				noclipSaved[part] = true
			end
			part.CanCollide = false
		end
	end
end
local function setNoclip(on, why)
	if on then
		if noclipSaved then
			return
		end
		noclipSaved = {}
		applyNoclip()
		pcall(function()
			noclipConn = RunService.Stepped:Connect(applyNoclip)
		end)
		log("เปิด noclip ชั่วคราว:", why or "")
	else
		if not noclipSaved then
			return
		end
		if noclipConn then
			pcall(function()
				noclipConn:Disconnect()
			end)
			noclipConn = nil
		end
		local saved = noclipSaved
		noclipSaved = nil
		for part, v in pairs(saved) do
			pcall(function()
				if part.Parent then
					part.CanCollide = v
				end
			end)
		end
		log("ปิด noclip คืนค่าการชนแล้ว")
	end
end
stopNoclip = function()
	setNoclip(false)
end

local function rayParamsFor(char)
	local ok, rp = pcall(function()
		local params = RaycastParams.new()
		local okEx = pcall(function()
			params.FilterType = Enum.RaycastFilterType.Exclude
		end)
		if not okEx then
			params.FilterType = Enum.RaycastFilterType.Blacklist
		end
		params.FilterDescendantsInstances = { char }
		pcall(function()
			params.RespectCanCollide = true
		end)
		return params
	end)
	return ok and rp or nil
end

-- มองไปข้างหน้า WALL_PROBE studs ตามทิศเป้าหมาย ยิง 3 ระดับ: เข่า / ลำตัว / เหนือหัว
-- คืน "none" = ทางโล่ง, "low" = กำแพงเตี้ยกระโดดข้ามได้, "high" = กำแพงสูงเกินกระโดด
local function wallAhead(root, rp, target)
	if not rp then
		return "none"
	end
	local p = root.Position
	local flat = Vector3.new(target.X - p.X, 0, target.Z - p.Z)
	local m = flat.Magnitude
	if m < 0.5 then
		return "none"
	end
	local dir = flat.Unit * math.min(CFG.WALL_PROBE, m)
	local function blocked(yOff)
		local ok, r = pcall(function()
			return workspace:Raycast(p + Vector3.new(0, yOff, 0), dir, rp)
		end)
		if not (ok and r and r.Instance) then
			return false
		end
		if r.Instance.CanCollide == false then
			return false
		end
		if r.Normal and r.Normal.Y > 0.6 then
			return false -- พื้นลาด/บันได เดินขึ้นได้ ไม่ใช่กำแพง
		end
		return true
	end
	local knee, chest, top = blocked(-1.5), blocked(0.5), blocked(4)
	if not (knee or chest) then
		return "none"
	end
	return top and "high" or "low"
end

