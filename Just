local function clamp(n, lo, hi)
	if n < lo then
		return lo
	elseif n > hi then
		return hi
	end
	return n
end

local function baitInfo(id)
	for _, b in ipairs(BAITS) do
		if b.id == id then
			return b
		end
	end
	return BAITS[3]
end

local function saveSettings()
	if not writefile then
		return
	end
	local kinds = {}
	for _, k in ipairs(KIND_LIST) do
		if S.sellKinds[k] then
			kinds[#kinds + 1] = k
		end
	end
	local text = table.concat({
		"autoSell=" .. (S.autoSell and "1" or "0"),
		"sellAll=" .. (S.sellAll and "1" or "0"),
		"kinds=" .. table.concat(kinds, ","),
