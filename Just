		end
	end
	return nil
end

-- หาช่องเบ็ดในกระเป๋า (ช่อง = ลำดับใน slots) เลือก: เบ็ดที่จำไว้ > เบ็ดพิเศษช่องแรก > fishing_rod
local function rodSlot()
	if type(bag.slots) ~= "table" then
		return nil
	end
	local want = S.rodId and rodBase(S.rodId)
	local bestFancy, bestAny = nil, nil
	for k, it in pairs(bag.slots) do
		if type(it) == "table" and isRodId(it.id) then
			local slot = (type(it.i) == "number" and it.i) or (type(k) == "number" and k) or nil
			if slot then
				if want and rodBase(it.id) == want then
					return slot, it.id
				end
				if rodBase(it.id) ~= "fishing_rod" and (not bestFancy or slot < bestFancy[1]) then
					bestFancy = { slot, it.id }
				end
				if not bestAny or slot < bestAny[1] then
					bestAny = { slot, it.id }
				end
			end
		end
	end
	local pick = bestFancy or bestAny
	if pick then
		return pick[1], pick[2]
	end
	return nil
end

local function equipRod()
	if not waitChar(10) then
		log("ไม่มีตัวละคร")
		return false
	end
	if getRod() then
		return true -- ถือเบ็ดอยู่แล้ว (เบ็ดไหนก็ได้) ห้ามส่ง use ซ้ำ ไม่งั้นเบ็ดหลุดมือ
	end
	-- 1) มีเบ็ดเป็น Tool อยู่ใน Backpack: ถือด้วย EquipTool
	local bp = lp:FindFirstChildOfClass("Backpack")
	local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
	if bp and hum then
		local pick = nil
		for _, t in ipairs(bp:GetChildren()) do
			if t:IsA("Tool") and isRodId(t.Name) then
				if S.rodId and rodBase(t.Name) == rodBase(S.rodId) then
					pick = t
					break
				end
				pick = pick or t
			end
		end
		if pick then
			log("ถือเบ็ดจาก Backpack:", pick.Name)
			pcall(function()
				hum:EquipTool(pick)
			end)
			local t0 = os.clock()
			while canRun() and os.clock() - t0 < 1.5 do
				task.wait(0.1)
				if getRod() then
					return true
				end
			end
		end
	end
	-- 2) ระบบกระเป๋าของเกม: BagRemotes.Action("use", ช่อง)
	local slot, id = rodSlot()
	if not slot then
		if bag.slots == nil then
			slot, id = 1, "?" -- ยังไม่ได้ข้อมูลกระเป๋า: ลองช่องแรกแบบเดิม
		else
			log("ไม่พบเบ็ดในกระเป๋า")
			return false
		end
	end
	log("ถือเบ็ด:", tostring(id), "ช่อง", slot)
	bagAction:FireServer("use", slot)
	local t0 = os.clock()
	while canRun() and os.clock() - t0 < CFG.EQUIP_TIMEOUT do
		task.wait(0.1)
		if getRod() then
			return true
		end
	end
	log("เบ็ดไม่ขึ้นมือภายใน", CFG.EQUIP_TIMEOUT, "วินาที")
	return false
end

